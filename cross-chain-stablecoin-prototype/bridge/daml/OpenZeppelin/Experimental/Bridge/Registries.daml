-- | The three contracts the gateways read at execution time: the attester
-- registry, the nonce registry, and the pause state. Each carries its
-- maintainer and its scope fields, and the gateways validate both against
-- values the caller does not control.
module OpenZeppelin.Experimental.Bridge.Registries where

import DA.Action (unless)
import DA.List (dedup, unique)
import DA.Map (Map)
import DA.Map qualified as Map

import OpenZeppelin.Api.PausableV1 (Pausable, PausableView(..))
import OpenZeppelin.PausableV1 qualified as Pausable
import OpenZeppelin.ScopedAuthorizationGrantV1 (Authorization(..))
import Splice.TokenStandard.Utils (require, requireMatchExpected)

import OpenZeppelin.Experimental.Bridge.Policy

-- Attester registry
--------------------

-- | The attester parties and the threshold N a quorum must reach. `ga` signs
-- it and is its only stakeholder; a listed attester reads it by disclosure.
template AttesterRegistry with
    maintainer : Party
    attesters : [Party]
    threshold : Int
  where
    signatory maintainer
    ensure threshold > 0 && threshold <= length attesters && unique attesters

    -- | Rotation: archive this version and create the next one.
    choice AttesterRegistry_Rotate : ContractId AttesterRegistry
      with
        newAttesters : [Party]
        newThreshold : Int
      controller maintainer
      do create this with attesters = newAttesters, threshold = newThreshold

    -- | A listed attester checks its own membership before it signs.
    nonconsuming choice AttesterRegistry_Read : AttesterRegistry
      with reader : Party
      controller reader
      do
        requireListedAttester this reader
        pure this

requireListedAttester : AttesterRegistry -> Party -> Update ()
requireListedAttester registry party =
  require "reader is a listed attester" (party `elem` registry.attesters)

-- | Count the distinct signers the registry lists against the threshold.
-- Signers the registry does not list are ignored.
requireQuorum : AttesterRegistry -> Text -> [Party] -> Update ()
requireQuorum registry what signers = do
  let listed = filter (`elem` registry.attesters) (dedup signers)
  require (what <> " is signed by a quorum of listed attesters")
    (length listed >= registry.threshold)

-- | Fetch the attester registry and check that `ga` maintains it.
fetchAttesterRegistry : Party -> ContractId AttesterRegistry -> Update AttesterRegistry
fetchAttesterRegistry ga cid = do
  registry <- fetch cid
  requireMatchExpected ("attesterRegistry.maintainer", registry.maintainer) ga
  pure registry

-- Nonce registry
-----------------

-- | The four states of a recorded lock nonce.
data NonceStatus
  = Minted
  | Closed
  | Refunded
  | Held
  deriving (Eq, Show)

-- | The nonces of one instrument and one epoch, a range of `E` consecutive
-- nonces. The gateway checks the epoch against the lock's nonce divided by
-- `E`, which the gateway carries.
template NonceRegistry with
    maintainer : Party
    instrumentId : Text
    epoch : Int
    nonces : Map Int NonceStatus
    successorCreated : Bool
  where
    signatory maintainer
    ensure epoch >= 0

    -- | Record a nonce. The first write of an epoch's registry also creates
    -- the next epoch's registry, so each epoch gets exactly one registry.
    choice NonceRegistry_Record : ContractId NonceRegistry
      with
        nonce : Int
        status : NonceStatus
      controller maintainer
      do
        unless successorCreated $ do
          _ <- create this with epoch = epoch + 1, nonces = Map.empty, successorCreated = False
          pure ()
        create this with nonces = Map.insert nonce status nonces, successorCreated = True

    -- | A listed attester reads a nonce's status before it signs a lock
    -- attestation or a refund statement.
    nonconsuming choice NonceRegistry_Read : Optional NonceStatus
      with
        reader : Party
        attesterRegistryCid : ContractId AttesterRegistry
        nonce : Int
      controller reader
      do
        attesterRegistry <- fetchAttesterRegistry maintainer attesterRegistryCid
        requireListedAttester attesterRegistry reader
        pure (Map.lookup nonce nonces)

-- | Fetch the nonce registry and check its maintainer, instrument, and epoch
-- against the gateway's own values and the lock's nonce.
fetchNonceRegistry
  : Party -> Text -> Int -> Int -> ContractId NonceRegistry -> Update NonceRegistry
fetchNonceRegistry ga instrumentId epochSize nonce cid = do
  registry <- fetch cid
  requireMatchExpected ("nonceRegistry.maintainer", registry.maintainer) ga
  requireMatchExpected ("nonceRegistry.instrumentId", registry.instrumentId) instrumentId
  requireMatchExpected ("nonceRegistry.epoch", registry.epoch) (nonce / epochSize)
  pure registry

-- Pause state
--------------

-- | The emergency stop of one instrument's bridge. `ga` signs it; the holder
-- of the pause role grant flips it.
template BridgePauseState with
    maintainer : Party
    instrumentId : Text
    paused : Bool
  where
    signatory maintainer

    interface instance Pausable for BridgePauseState where
      view = PausableView with paused

    choice BridgePauseState_Pause : ContractId BridgePauseState
      with authorization : Authorization
      controller authorization.actor
      do
        requireRole maintainer (pauseScope instrumentId) authorization
        Pausable.whenNotPaused this
        create this with paused = True

    choice BridgePauseState_Unpause : ContractId BridgePauseState
      with authorization : Authorization
      controller authorization.actor
      do
        requireRole maintainer (pauseScope instrumentId) authorization
        Pausable.whenPaused this
        create this with paused = False

-- | Fetch the pause state and check its maintainer and instrument.
fetchPauseState : Party -> Text -> ContractId BridgePauseState -> Update BridgePauseState
fetchPauseState ga instrumentId cid = do
  state <- fetch cid
  requireMatchExpected ("pauseState.maintainer", state.maintainer) ga
  requireMatchExpected ("pauseState.instrumentId", state.instrumentId) instrumentId
  pure state

-- | Fail unless the pause state `ga` maintains for the instrument is clear.
requireNotPaused : Party -> Text -> ContractId BridgePauseState -> Update ()
requireNotPaused ga instrumentId cid = do
  state <- fetchPauseState ga instrumentId cid
  Pausable.whenNotPaused state
