-- | Regulated-settlement consumer experiment composing three controls around
-- atomic settlement:
--   * pausable    - an emergency circuit breaker (whenNotPaused) gating new
--                   settlements;
--   * access-control - the settlement executor must hold a granted role;
--   * cip112-settlement - atomic, value-moving, attested batch settlement with
--                   the V2-aligned EventLog, plus the D2 lawful-seizure path.
module OpenZeppelin.Experimental.Settlement.Exemplar where

import DA.Assert ((===))
import DA.Date (date, Month(Jan))
import DA.Optional (isNone)
import DA.Time (time)
import Daml.Script

import OpenZeppelin.AccessControlV1 (RoleGrant(..), requireRole)
import OpenZeppelin.PausableV1

import OpenZeppelin.Experimental.Settlement.Cip112
import OpenZeppelin.Experimental.TokenStandardFixture.V2.Metadata
import OpenZeppelin.Experimental.TokenStandardFixture.V2.Holding
import OpenZeppelin.Experimental.TokenStandardFixture.V2.Allocation
  ( Reference(..), SettlementInfo(..), TransferLeg(..)
  , AllocationSpecification(..)
  )

settlementExecutorRole : Text
settlementExecutorRole = "SETTLEMENT_EXECUTOR_ROLE"

-- | The consumer application. Owned by the registry `admin`; it composes the
-- pause guard and the executor role check around the settlement library's
-- attested batch entrypoint.
--
-- Signatories: `admin`. Observers: none (cids are disclosed to the executor).
-- Authorization: exercising a choice runs with admin's authority (app
-- signatory), which is what lets the composed settlement fetch the admin-signed
-- pause state, role grant, attestation registry, and factory.
template RegulatedSettlementApp
  with
    admin : Party
  where
    signatory admin

    -- | Settle a batch only when (a) the app is not paused and (b) the caller
    -- holds the settlement-executor role - then delegate to the library's
    -- attested, value-moving batch settlement.
    nonconsuming choice RegulatedSettlementApp_SettleWithControls : [ContractId SettlementReceipt]
      with
        executor : Party
        executorGrant : ContractId RoleGrant
        pauseStateCid : ContractId PauseState
        factoryCid : ContractId SettlementFactory
        settlement : SettlementInfo
        transferLegs : [TransferLeg]
        allocationCids : [ContractId Allocation]
        attestationCid : ContractId NodeComplianceAttestation
        registryCid : ContractId TrustedAttesterRegistry
      controller executor
      do
        -- Pausable: emergency circuit breaker on new settlements.
        ps <- fetch pauseStateCid
        whenNotPaused ps
        -- Access-control: the executor must hold the granted role.
        grant <- fetch executorGrant
        requireRole executor settlementExecutorRole admin grant
        -- Settlement library: atomic, attested, value-moving batch settlement.
        exercise factoryCid SettlementFactory_SettleBatchWithAttestation with
          settlement
          transferLegs
          allocationCids
          actors = [executor]
          attestationCid
          registryCid

-- Fixed times for the exemplar timeline.
e0 : Time
e0 = time (date 2026 Jan 1) 0 0 0

e1 : Time
e1 = time (date 2026 Jan 1) 1 0 0

-- | Build alice's funded (SenderSide) allocation and bob's (ReceiverSide)
-- allocation for a single USD leg, going through the real request/instruction
-- lifecycle, and return the leg, settlement info, and the two allocation cids.
buildTwoSidedAllocations
  : Party -> Party -> Party -> Party -> ContractId SettlementFactory -> Disclosure
  -> Script (SettlementInfo, TransferLeg, [ContractId Allocation])
buildTwoSidedAllocations admin app alice bob factory factoryDisclosure = do
  let aliceAccount = basicAccount alice
      bobAccount = basicAccount bob
      settlement = SettlementInfo with
        executors = [app]
        settlementRef = Reference with id = "exemplar-settlement"; cidText = None
        settlementDeadline = Some e1
        meta = emptyMetadata
      leg = TransferLeg with
        transferLegId = "exemplar-leg-1"
        sender = aliceAccount
        receiver = bobAccount
        amount = 100.0
        instrumentId = "USD"
        meta = emptyMetadata
      aliceSide = senderSide leg
      bobSide = receiverSide leg
      instrument = InstrumentId with admin; id = "USD"

  aliceHolding <- submit [admin, alice] do
    createCmd ToyHolding with
      admin
      account = aliceAccount
      instrumentId = instrument
      amount = 100.0
      lock = None
      meta = emptyMetadata
      featureFlag = experimentalFeatureFlag

  aliceInstruction <- submit (actAs alice <> discloseMany [factoryDisclosure]) do
    exerciseCmd factory SettlementFactory_CreateAllocationInstruction with
      allocation = AllocationSpecification with
        settlement; admin; authorizer = aliceAccount
        transferLegSides = [aliceSide]; nextIterationFunding = None
        committed = True; meta = emptyMetadata
      requestedAt = e0
      inputHoldingCids = [aliceHolding]
      d1ComplianceHook = Some (D1ComplianceHook with hookRef = "exemplar-node-check"; requiresPerSettlementReference = True)
      actors = [alice]
  aliceResult <- submit alice do
    exerciseCmd aliceInstruction AllocationInstruction_Accept with actors = [alice]
  aliceAllocation <- case aliceResult of
    AllocationInstructionCompleted cid -> pure cid
    _ -> abort "exemplar: alice allocation did not complete"

  bobInstruction <- submit (actAs bob <> discloseMany [factoryDisclosure]) do
    exerciseCmd factory SettlementFactory_CreateAllocationInstruction with
      allocation = AllocationSpecification with
        settlement; admin; authorizer = bobAccount
        transferLegSides = [bobSide]; nextIterationFunding = None
        committed = False; meta = emptyMetadata
      requestedAt = e0
      inputHoldingCids = []
      d1ComplianceHook = Some (D1ComplianceHook with hookRef = "exemplar-node-check"; requiresPerSettlementReference = True)
      actors = [bob]
  bobResult <- submit bob do
    exerciseCmd bobInstruction AllocationInstruction_Accept with actors = [bob]
  bobAllocation <- case bobResult of
    AllocationInstructionCompleted cid -> pure cid
    _ -> abort "exemplar: bob allocation did not complete"

  pure (settlement, leg, [aliceAllocation, bobAllocation])

-- | End-to-end: pausable + access-control + attested, value-moving settlement.
regulatedSettlementExemplar : Script ()
regulatedSettlementExemplar = script do
  setTime e0
  admin <- allocateParty "exemplar-registry-admin"
  app <- allocateParty "exemplar-app-executor"
  alice <- allocateParty "exemplar-alice"
  bob <- allocateParty "exemplar-bob"
  attester <- allocateParty "exemplar-node-attester"

  -- The application combines a running pause state with an executor role grant.
  pauseState <- submit admin do createCmd PauseState with pauser = admin; paused = False
  executorGrant <- submit admin do
    createCmd RoleGrant with admin; account = app; role = settlementExecutorRole
  appCid <- submit admin do createCmd RegulatedSettlementApp with admin

  factory <- submit admin do
    createCmd SettlementFactory with admin; requiresNodeAttestation = None; featureFlag = experimentalFeatureFlag
  Some factoryDisclosure <- queryDisclosure @SettlementFactory admin factory

  (settlement, leg, allocationCids) <-
    buildTwoSidedAllocations admin app alice bob factory factoryDisclosure

  -- The node emits a typed compliance attestation covering this settlement.
  registry <- submit admin do
    createCmd TrustedAttesterRegistry with admin; attesters = [attester]; featureFlag = experimentalFeatureFlag
  attestation <- submit attester do
    createCmd NodeComplianceAttestation with
      attester
      attestationObservers = [admin]
      settlementRef = settlement.settlementRef.id
      boundTransferLegIds = Some [leg.transferLegId]
      claimKind = "OFAC_CLEARED"
      issuedAt = e0
      expiresAt = e1
      featureFlag = experimentalFeatureFlag

  -- Pause blocks settlement: flip on, attempt, expect failure, flip back.
  pausedState <- submit admin do exerciseCmd pauseState PauseState_Set with newPaused = True
  submitMustFail (actAs [app] <> readAs [admin]) do
    exerciseCmd appCid RegulatedSettlementApp_SettleWithControls with
      executor = app; executorGrant; pauseStateCid = pausedState; factoryCid = factory
      settlement; transferLegs = [leg]; allocationCids; attestationCid = attestation; registryCid = registry
  runningState <- submit admin do exerciseCmd pausedState PauseState_Set with newPaused = False

  -- Happy path: executor settles through the app's composed controls.
  receiptCids <- submit (actAs [app] <> readAs [admin]) do
    exerciseCmd appCid RegulatedSettlementApp_SettleWithControls with
      executor = app; executorGrant; pauseStateCid = runningState; factoryCid = factory
      settlement; transferLegs = [leg]; allocationCids; attestationCid = attestation; registryCid = registry
  length receiptCids === 2

  -- Bob is credited the 100 USD leg; alice's input is consumed.
  bobHoldings <- query @ToyHolding bob
  length (filter (\(_, h) -> h.amount == 100.0 && isNone h.lock) bobHoldings) === 1
  aliceHoldings <- query @ToyHolding alice
  length aliceHoldings === 0

  -- The V2-aligned EventLog recorded the holdings changes (one per allocation).
  entries <- query @SettlementEventLogEntry admin
  length entries === 2

-- | Separate scenario: a lawful in-flight seizure routes a sender's locked
-- holding to a preset custodian after the deadline, under a lawful window.
regulatedSeizureExemplar : Script ()
regulatedSeizureExemplar = script do
  setTime e0
  admin <- allocateParty "exemplar-seize-admin"
  app <- allocateParty "exemplar-seize-app"
  alice <- allocateParty "exemplar-seize-alice"
  bob <- allocateParty "exemplar-seize-bob"

  factory <- submit admin do
    createCmd SettlementFactory with admin; requiresNodeAttestation = None; featureFlag = experimentalFeatureFlag
  Some factoryDisclosure <- queryDisclosure @SettlementFactory admin factory
  (_settlement, _leg, allocationCids) <-
    buildTwoSidedAllocations admin app alice bob factory factoryDisclosure

  burnerCap <- submit admin do
    createCmd BurnerCapability with
      admin; assignee = admin
      instrumentScope = Some (InstrumentId with admin; id = "USD")
      featureFlag = experimentalFeatureFlag
  let custodian = Account with owner = None; provider = Some admin; id = "exemplar-custodian"
      seizureHook = D2SeizureHook with
        seizureCaseRef = "exemplar-seizure-case"
        custodianDestination = custodian
        inFlightHandlingStatus = "lock-and-sweep"

  case allocationCids of
    aliceAllocation :: _ -> do
      marked <- submit admin do
        exerciseCmd aliceAllocation Allocation_MarkD2WithWindow with
          actors = [admin]; seizureHook; windowEnd = e1
      setTime e1
      result <- submit admin do
        exerciseCmd marked Allocation_SweepD2WithLawfulProcess with
          burner = admin; burnerCapCid = Some burnerCap
          lawfulProcessRef = "exemplar-court-order-001"
      case result of
        AllocationD2Swept cids -> length cids === 1
        _ -> abort "exemplar: expected AllocationD2Swept"
    [] -> abort "exemplar: expected an allocation to seize"
