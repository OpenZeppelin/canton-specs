-- | Experimental fixture approximating selected
-- `splice-api-token-allocation-request-v2` types for local tests. It is not an
-- upstream implementation or a conformance artifact. The interface is
-- viewtype-only; implementing templates define their own choice behavior.
module OpenZeppelin.Experimental.TokenStandardFixture.V2.AllocationRequest where

import OpenZeppelin.Experimental.TokenStandardFixture.V2.Metadata
import OpenZeppelin.Experimental.TokenStandardFixture.V2.Holding
import OpenZeppelin.Experimental.TokenStandardFixture.V2.Allocation

-- | Viewtype for the `AllocationRequest` interface. Mirrors
-- `AllocationRequestV2.AllocationRequestView`.
data AllocationRequestView = AllocationRequestView with
    authorizer : Account
    settlement : SettlementInfo
    allocations : [RequestedAllocation]
    settleAt : Optional Time
    meta : Metadata
  deriving (Eq, Show)

interface AllocationRequest where
  viewtype AllocationRequestView
