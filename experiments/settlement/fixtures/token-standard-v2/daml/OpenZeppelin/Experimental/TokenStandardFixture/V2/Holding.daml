-- | Experimental fixture approximating selected Token Standard V2 holding
-- types for local settlement tests. It is not an upstream implementation or a
-- conformance artifact.
--
-- The modeled surface includes:
-- `InstrumentId`, `Account`, `Lock`, and the `Holding` interface (viewtype
-- `HoldingView`). The fixture keeps the interface viewtype-only; concrete
-- crediting and locking behavior lives on implementing experiment templates.
module OpenZeppelin.Experimental.TokenStandardFixture.V2.Holding where

import OpenZeppelin.Experimental.TokenStandardFixture.V2.Metadata

-- | Instrument identity: the issuing admin plus a textual id. Mirrors
-- `HoldingV2.InstrumentId`.
data InstrumentId = InstrumentId with
    admin : Party
    id : Text
  deriving (Eq, Ord, Show)

-- | Holding account. Mirrors `HoldingV2.Account` (`owner`/`provider`/`id`).
data Account = Account with
    owner : Optional Party
    provider : Optional Party
    id : Text
  deriving (Eq, Ord, Show)

-- | A basic owner-only account, matching the upstream `basicAccount` helper.
basicAccount : Party -> Account
basicAccount owner = Account with
  owner = Some owner
  provider = None
  id = ""

-- | Lock embedded on a locked holding. Mirrors `HoldingV1.Lock` as surfaced on
-- the V2 holding view.
data Lock = Lock with
    holders : [Party]
    expiresAt : Optional Time
    context : Optional Text
  deriving (Eq, Show)

-- | Viewtype for the `Holding` interface. Mirrors `HoldingV2.HoldingView`.
data HoldingView = HoldingView with
    account : Account
    instrumentId : InstrumentId
    amount : Decimal
    lock : Optional Lock
    meta : Metadata
  deriving (Eq, Show)

-- | The V2 holding interface. Data-only by design; implementers are concrete
-- holding templates that own signatory/observer/lock/credit semantics.
interface Holding where
  viewtype HoldingView
