-- | Experimental fixture approximating selected
-- `splice-api-token-allocation-instruction-v2` types for local tests. It is not
-- an upstream implementation or a conformance artifact. The interface is
-- viewtype-only; implementing templates define their own choice behavior.
module OpenZeppelin.Experimental.TokenStandardFixture.V2.AllocationInstruction where

import OpenZeppelin.Experimental.TokenStandardFixture.V2.Metadata
import OpenZeppelin.Experimental.TokenStandardFixture.V2.Holding
import OpenZeppelin.Experimental.TokenStandardFixture.V2.Allocation

-- | Viewtype for the `AllocationInstruction` interface. Mirrors
-- `AllocationInstructionV2.AllocationInstructionView`.
data AllocationInstructionView = AllocationInstructionView with
    allocation : AllocationSpecification
    requestedAt : Time
    inputHoldingCids : [ContractId Holding]
    meta : Metadata
  deriving (Eq, Show)

interface AllocationInstruction where
  viewtype AllocationInstructionView
