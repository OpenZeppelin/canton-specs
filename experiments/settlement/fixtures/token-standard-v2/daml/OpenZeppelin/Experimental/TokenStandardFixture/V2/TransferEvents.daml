-- | Experimental fixture approximating selected
-- `splice-api-token-transfer-events-v2` types for local tests. It is not an
-- upstream implementation or a conformance artifact. It provides a viewtype-only
-- `EventLog` interface and an `EventLog_HoldingsChange` record; implementing
-- experiment templates define emission behavior.
module OpenZeppelin.Experimental.TokenStandardFixture.V2.TransferEvents where

import OpenZeppelin.Experimental.TokenStandardFixture.V2.Metadata
import OpenZeppelin.Experimental.TokenStandardFixture.V2.Holding
import OpenZeppelin.Experimental.TokenStandardFixture.V2.Allocation (TransferSide)

-- | The transfer-events leg side. Mirrors `TransferEventsV2.TransferLegSide`
-- (`side` / `transferLegId` / `otherside`).
data EventLogTransferLegSide = EventLogTransferLegSide with
    side : TransferSide
    transferLegId : Text
    otherside : Account
  deriving (Eq, Show)

-- | The holdings-change event. Mirrors `TransferEventsV2.EventLog_HoldingsChange`:
-- the inputs consumed and outputs created in a settlement/seizure step.
data EventLog_HoldingsChange = EventLog_HoldingsChange with
    admin : Party
    account : Account
    inputHoldingCids : [ContractId Holding]
    outputHoldingCids : [ContractId Holding]
    transferLegSides : [EventLogTransferLegSide]
    observers : [Party]
    meta : Metadata
  deriving (Eq, Show)

-- | Viewtype for the `EventLog` interface. Mirrors `TransferEventsV2.EventLogView`.
data EventLogView = EventLogView with
    admin : Party
    meta : Metadata
  deriving (Eq, Show)

interface EventLog where
  viewtype EventLogView
