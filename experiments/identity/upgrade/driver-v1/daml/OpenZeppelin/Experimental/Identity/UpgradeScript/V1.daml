-- | Daml Script driver for the experimental identity hook upgrade v0.1.0 DAR.
module OpenZeppelin.Experimental.Identity.UpgradeScript.V1 where

import DA.Action (when)
import DA.Assert ((===))
import DA.Foldable (forA_)
import Daml.Script

import OpenZeppelin.Experimental.Identity.Upgrade

data MigrationFixture = MigrationFixture with
    issuer : Party
    alice : Party
    bob : Party
    holding : ContractId ToyHolding
  deriving (Eq, Show)

data MigrationRun = MigrationRun with
    runId : Text
  deriving (Eq, Show)

baselineAttestation : OpaqueIdentityAttestation
baselineAttestation = OpaqueIdentityAttestation with
  envelope = "opaque-single-domain-identity-attestation"

scriptPartyHint : Text -> Text -> Text
scriptPartyHint runId role = "identity-hook-upgrade-script-v1-" <> role <> "-" <> runId

-- | Allocate a fixture party and let the Ledger API admin users act as it.
--
-- A Canton LocalNet participant authenticates the Ledger API. A user may then
-- submit for a party only if a `CanActAs` right names that party, and party
-- allocation grants no such right. The v2 driver submits for the same parties
-- in the second phase of the smoke gate, so the grant must outlive this script.
-- The in-memory ledger of `dpm test` needs no grant, and it reports no admin
-- user, so the grant does nothing there.
allocateDriverParty : Text -> Script Party
allocateDriverParty requestedName = do
  party <- allocateParty requestedName
  users <- listAllUsers
  forA_ users $ \user -> do
    rights <- listUserRights user.userId
    when (ParticipantAdmin `elem` rights) do
      _ <- grantUserRights user.userId [CanActAs party]
      pure ()
  pure party

-- | Creates a v0.1.0 holding and returns the parties/contract id for a v0.2.0
-- migration script running on the same ledger.
createV1HoldingFixture : Script MigrationFixture
createV1HoldingFixture = createV1HoldingFixtureWithRunId "test"

-- | Creates the fixture with caller-provided party hints so live-ledger upgrade
-- validation can be repeated against a persistent participant without party
-- collisions.
createV1HoldingFixtureForRun : MigrationRun -> Script MigrationFixture
createV1HoldingFixtureForRun run = createV1HoldingFixtureWithRunId run.runId

createV1HoldingFixtureWithRunId : Text -> Script MigrationFixture
createV1HoldingFixtureWithRunId runId = script do
  issuer <- allocateDriverParty (scriptPartyHint runId "issuer")
  alice <- allocateDriverParty (scriptPartyHint runId "alice")
  bob <- allocateDriverParty (scriptPartyHint runId "bob")

  registry <- submit issuer do
    createCmd ToyRegistry with
      issuer
      featureFlag = experimentalFeatureFlag
  holding <- submit issuer do
    exerciseCmd registry ToyRegistry_Mint with owner = alice, amount = 125
  pure MigrationFixture with issuer, alice, bob, holding

-- | v0.1.0 script smoke: mint a toy holding and transfer it with the baseline
-- opaque single-domain identity-attestation argument.
test_identityHookUpgradeV1Script_smokeTransfer : Script ()
test_identityHookUpgradeV1Script_smokeTransfer = script do
  fixture <- createV1HoldingFixture
  bobHolding <- submit fixture.alice do
    exerciseCmd fixture.holding ToyHolding_Transfer with
      newOwner = fixture.bob
      identityAttestation = baselineAttestation
  Some transferred <- queryContractId fixture.bob bobHolding
  transferred.owner === fixture.bob
  transferred.amount === 125
  pure ()

-- | The issuer controls the baseline registry and holding archival paths.
test_identityHookUpgradeV1Script_archiveAuthority : Script ()
test_identityHookUpgradeV1Script_archiveAuthority = script do
  issuer <- allocateParty "identity-hook-upgrade-script-v1-archive-issuer"
  owner <- allocateParty "identity-hook-upgrade-script-v1-archive-owner"
  registry <- submit issuer do
    createCmd ToyRegistry with
      issuer
      featureFlag = experimentalFeatureFlag
  holding <- submit issuer do
    exerciseCmd registry ToyRegistry_Mint with owner; amount = 125
  submitMustFail owner do
    exerciseCmd holding Archive
  submit issuer do
    exerciseCmd holding Archive
  submit issuer do
    exerciseCmd registry Archive
