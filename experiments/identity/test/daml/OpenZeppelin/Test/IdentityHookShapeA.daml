-- | Smoke test for experimental identity hook shape A.
module OpenZeppelin.Test.IdentityHookShapeA where

import DA.Assert ((===))
import Daml.Script

import OpenZeppelin.Experimental.Identity.ShapeA

-- | Shape A composes an opaque identity attestation argument with the toy
-- single-domain mint and transfer path.
test_identityHookShapeA_smokeTransfer : Script ()
test_identityHookShapeA_smokeTransfer = script do
  issuer <- allocateParty "identity-shape-a-issuer"
  alice <- allocateParty "identity-shape-a-alice"
  bob <- allocateParty "identity-shape-a-bob"

  registry <- submit issuer do
    createCmd ToyRegistry with
      issuer
      featureFlag = experimentalFeatureFlag
  holding <- submit issuer do
    exerciseCmd registry ToyRegistry_Mint with owner = alice, amount = 100
  bobHolding <- submit alice do
    exerciseCmd holding ToyHolding_Transfer with
      newOwner = bob
      identityAttestation = OpaqueIdentityAttestation with
        envelope = "opaque-single-domain-identity-attestation"
  Some transferred <- queryContractId bob bobHolding
  transferred.owner === bob
  transferred.amount === 100
  pure ()

-- Destruction authority (the implicit Archive choice)
-------------------------------------------------------

-- | Only the issuer can archive the registry; an archived contract ID cannot be
-- used to mint.
test_identityHookShapeA_registryArchiveRemovesMintSurface : Script ()
test_identityHookShapeA_registryArchiveRemovesMintSurface = script do
  issuer <- allocateParty "identity-shape-a-reg-archive-issuer"
  alice <- allocateParty "identity-shape-a-reg-archive-alice"

  registry <- submit issuer do
    createCmd ToyRegistry with
      issuer
      featureFlag = experimentalFeatureFlag
  submitMustFail alice do archiveCmd registry
  submit issuer do archiveCmd registry
  submitMustFail issuer do
    exerciseCmd registry ToyRegistry_Mint with owner = alice, amount = 100
  pure ()

-- | Destruction authority over a toy holding sits with the issuer (its sole
-- signatory); the owner only observes it and cannot archive it.
test_identityHookShapeA_holdingArchiveIsIssuerOnly : Script ()
test_identityHookShapeA_holdingArchiveIsIssuerOnly = script do
  issuer <- allocateParty "identity-shape-a-hold-archive-issuer"
  alice <- allocateParty "identity-shape-a-hold-archive-alice"

  registry <- submit issuer do
    createCmd ToyRegistry with
      issuer
      featureFlag = experimentalFeatureFlag
  holding <- submit issuer do
    exerciseCmd registry ToyRegistry_Mint with owner = alice, amount = 100
  submitMustFail alice do archiveCmd holding
  submit issuer do archiveCmd holding
  res <- queryContractId issuer holding
  res === None
