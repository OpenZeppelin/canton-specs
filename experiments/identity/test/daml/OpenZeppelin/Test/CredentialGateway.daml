-- | Tests for the experimental credential gateway's authorization, validity,
-- and revocation checks.
module OpenZeppelin.Test.CredentialGateway where

import DA.Date (date, Month(Jan))
import DA.Time (time)
import Daml.Script

import OpenZeppelin.Experimental.Credential.Gateway

t0 : Time
t0 = time (date 2026 Jan 1) 0 0 0

t1 : Time
t1 = time (date 2026 Jan 1) 1 0 0

createFixture
  : Party
  -> Party
  -> Party
  -> CredentialRevocationStatus
  -> Script
       ( ContractId MockVerifierAuthorization
       , ContractId MockVerificationResult
       , ContractId CredentialGatedActionRequest
       )
createFixture admin verifier subject revocationStatus = do
  authorization <- submit admin do
    createCmd MockVerifierAuthorization with
      admin
      verifier
      authorizedKinds = [KYC_VERIFIED]
      featureFlag = experimentalFeatureFlag
  result <- submit verifier do
    createCmd MockVerificationResult with
      verifier
      subject
      disclosedTo = [admin]
      claimKind = KYC_VERIFIED
      revocationStatus
      issuedAt = t0
      expiresAt = t1
      featureFlag = experimentalFeatureFlag
  request <- submit subject do
    createCmd CredentialGatedActionRequest with
      requester = subject
      gatekeeper = admin
      subject
      actionRef = "credential-gateway-test"
      requiredKind = KYC_VERIFIED
      featureFlag = experimentalFeatureFlag
  pure (authorization, result, request)

test_credentialGateway_acceptsAuthorizedActiveResult : Script ()
test_credentialGateway_acceptsAuthorizedActiveResult = script do
  setTime t0
  admin <- allocateParty "credential-gateway-admin"
  verifier <- allocateParty "credential-gateway-verifier"
  subject <- allocateParty "credential-gateway-subject"
  (authorizationCid, resultCid, requestCid) <-
    createFixture admin verifier subject CredentialActive
  submit admin do
    exerciseCmd requestCid CredentialGatedActionRequest_Gate with
      actors = [admin]
      authorizationCid
      resultCid

test_credentialGateway_rejectsRevokedResult : Script ()
test_credentialGateway_rejectsRevokedResult = script do
  setTime t0
  admin <- allocateParty "credential-gateway-revoked-admin"
  verifier <- allocateParty "credential-gateway-revoked-verifier"
  subject <- allocateParty "credential-gateway-revoked-subject"
  (authorizationCid, resultCid, requestCid) <-
    createFixture admin verifier subject CredentialRevoked
  submitMustFail admin do
    exerciseCmd requestCid CredentialGatedActionRequest_Gate with
      actors = [admin]
      authorizationCid
      resultCid

test_credentialGateway_rejectsExpiredResult : Script ()
test_credentialGateway_rejectsExpiredResult = script do
  setTime t0
  admin <- allocateParty "credential-gateway-expired-admin"
  verifier <- allocateParty "credential-gateway-expired-verifier"
  subject <- allocateParty "credential-gateway-expired-subject"
  (authorizationCid, resultCid, requestCid) <-
    createFixture admin verifier subject CredentialActive
  setTime (time (date 2026 Jan 1) 2 0 0)
  submitMustFail admin do
    exerciseCmd requestCid CredentialGatedActionRequest_Gate with
      actors = [admin]
      authorizationCid
      resultCid

test_credentialGateway_archivalAuthority : Script ()
test_credentialGateway_archivalAuthority = script do
  setTime t0
  admin <- allocateParty "credential-gateway-archive-admin"
  verifier <- allocateParty "credential-gateway-archive-verifier"
  subject <- allocateParty "credential-gateway-archive-subject"
  (authorizationCid, resultCid, requestCid) <-
    createFixture admin verifier subject CredentialActive

  submitMustFail verifier do archiveCmd authorizationCid
  submit admin do archiveCmd authorizationCid

  submitMustFail subject do archiveCmd resultCid
  submit verifier do archiveCmd resultCid

  submitMustFail admin do archiveCmd requestCid
  submit subject do archiveCmd requestCid
