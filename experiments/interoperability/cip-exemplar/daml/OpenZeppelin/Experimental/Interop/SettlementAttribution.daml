-- | Settlement attribution: which settlements an app-provider may claim.
--
-- CIP-0104 pays a featured app-provider for the sequencer and mediator traffic
-- that its transactions cause. The network measures that traffic, attributes it
-- to the `FeaturedAppRight` holders in the transaction, and mints the reward from
-- it, without any app-level record of a reward. The gate
-- `scripts/localnet-cip0104-traffic-rewards.sh` drives that reward path on a
-- LocalNet which runs Amulet, Scan, and an SV.
--
-- An app-provider may claim the settlements that it confirmed as executor, and
-- only those. This module shows that the settlement views alone carry that
-- distinction:
--
-- * the ledger functions that an integrator calls
-- * the balances before and after each action
-- * how the executor-confirmed activity of the app-provider increases
-- * why the receipts that the app-provider merely observes do not count.
--
-- The function `attributedActivity` reads only `query` results over
-- `SettlementReceipt` and `SettlementEventLogEntry`. It creates no contract.
--
-- Scope: experimental interoperability behavior. These scenarios make no
-- CIP-0104 reward, SV, or Scan production claim.
module OpenZeppelin.Experimental.Interop.SettlementAttribution where

import DA.Assert ((===))
import DA.List (dedup)
import DA.Optional (isNone)
import Daml.Script

import OpenZeppelin.Experimental.Settlement.Cip112
import OpenZeppelin.Experimental.Interop.Common
import OpenZeppelin.Experimental.TokenStandardFixture.V2.Allocation (TransferSide(..))
import OpenZeppelin.Experimental.TokenStandardFixture.V2.Holding

-- | The activity of the app-provider as the confirming executor. The data
-- comes only from the two settlement views that the executor observes. No
-- marker contract supplies it.
data AttributedActivity = AttributedActivity with
    settlements : Int        -- ^ count of executor-confirmed batches (unique settlement refs)
    settledVolume : Decimal  -- ^ sum of the confirmed USD sender-leg amounts
    holdingsChangeEvents : Int -- ^ count of `EventLog_HoldingsChange` entries of confirmed batches
  deriving (Eq, Show)

-- | Off-ledger attribution: read the projection of the app-provider for
-- `SettlementReceipt` and `SettlementEventLogEntry`. Keep only the
-- settlements that the app-provider confirmed as executor. Visibility alone
-- does not attribute: the app-provider also observes receipts as an account
-- party when it sends or receives in a settlement that an other party
-- executes, and the function must not credit those. Each settled batch makes
-- one receipt for each authorizer, and these receipts have the same
-- settlement ref. Thus the function counts batches by unique ref. The sender
-- side of each leg is in exactly one receipt. Thus the function adds the USD
-- sender-side amounts to get the volume. An event counts only when one of
-- its transfer legs is in a confirmed receipt.
attributedActivity : Party -> Script AttributedActivity
attributedActivity app = do
  receipts <- query @SettlementReceipt app
  events <- query @SettlementEventLogEntry app
  let confirmed = [r | (_, r) <- receipts, app `elem` r.settlement.executors]
      refs = dedup [r.settlement.settlementRef.id | r <- confirmed]
      confirmedLegIds =
        dedup [s.transferLegId | r <- confirmed, s <- r.settledTransferLegSides]
      senderAmounts =
        [ s.amount
        | r <- confirmed, s <- r.settledTransferLegSides
        , s.side == SenderSide, s.instrumentId == usdSymbol
        ]
      confirmedEvents =
        [ e
        | (_, e) <- events
        , any (\s -> s.transferLegId `elem` confirmedLegIds) e.event.transferLegSides
        ]
  pure AttributedActivity with
    settlements = length refs
    settledVolume = sum senderAmounts
    holdingsChangeEvents = length confirmedEvents

-- * Walkthrough helpers

-- | Write one snapshot to the log: the issuer-view balances and the attributed
-- activity of the app-provider. The function returns the activity, and the
-- walkthrough makes assertions on it.
logSnapshot : Text -> Party -> Party -> Account -> Account -> Script AttributedActivity
logSnapshot label admin app aliceAcct bobAcct = do
  aliceBal <- erc20BalanceOf admin aliceAcct
  bobBal <- erc20BalanceOf admin bobAcct
  supply <- erc20TotalSupply admin
  activity <- attributedActivity app
  debug $ "== " <> label <> " =="
  debug $ "balances (issuer view): alice=" <> show aliceBal
    <> " USD, bob=" <> show bobBal
    <> " USD, totalSupply=" <> show supply <> " USD"
  debug $ "attribution (app view): settlements=" <> show activity.settlements
    <> ", settledVolume=" <> show activity.settledVolume
    <> " USD, holdingsChangeEvents=" <> show activity.holdingsChangeEvents
  pure activity

-- | Find the unlocked USD holding of `account` that has the given amount, as
-- `reader` sees it. The issuer sees each holding that it signed.
holdingWithAmount : Party -> Account -> Decimal -> Script (ContractId ToyHolding)
holdingWithAmount reader account amount = do
  hs <- query @ToyHolding reader
  case [cid | (cid, h) <- hs, h.account == account, h.amount == amount, isNone h.lock] of
    cid :: _ -> pure cid
    [] -> abort $ "walkthrough: no unlocked holding of " <> show amount <> " found"

-- * Walkthrough

-- | Attribution walkthrough, end to end:
--
-- * Step 0 - the issuer mints; no activity is attributable.
-- * Step 1 - the app-provider settles alice -> bob 30 USD; the settle result
--   and the views alone give the attribution.
-- * Step 2 - a second settlement (bob -> alice 10 USD) increases the
--   counters.
-- * Step 3 - a party that is not the executor tries to settle a pending
--   batch; the attempt fails; the counters do not move, because only
--   confirmed executor activity is attributable.
-- * Step 4 - the app-provider settles that batch; the counters increase.
-- * Step 5 - an other executor settles a transfer where the app-provider is
--   only the receiver; the app-provider sees the receipt, but the attribution
--   does not change, because visibility alone does not attribute.
test_attribution_walkthrough : Script ()
test_attribution_walkthrough = script do
  admin <- allocateInteropParty "attribution-admin"
  app <- allocateInteropParty "attribution-app"
  alice <- allocateInteropParty "attribution-alice"
  bob <- allocateInteropParty "attribution-bob"
  notApp <- allocateInteropParty "attribution-notapp"
  let aliceAcct = basicAccount alice
      bobAcct = basicAccount bob

  -- Step 0: the issuer mints 100 USD to alice. No settlement occurred. Thus
  -- the app-provider has no attributable activity.
  aliceHolding <- mintUsd [admin, alice] admin aliceAcct 100.0
  activity0 <- logSnapshot "step 0: minted, nothing settled" admin app aliceAcct bobAcct
  activity0 === AttributedActivity 0 0.0 0

  -- Step 1: the app-provider executes a settlement that moves 30 USD from
  -- alice to bob (allocate the two sides, then `SettlementFactory_SettleBatch`).
  -- The balances change. The app-provider now observes 1 settlement, 30 USD
  -- volume, and 2 holdings-change events. That is its attribution surface.
  --
  -- The settle result carries one receipt for each authorizer, and each
  -- receipt names the app-provider as the only executor. That field is what
  -- `attributedActivity` filters on, so the walkthrough asserts it directly
  -- here, on the result of the choice itself, before it reads anything back
  -- from the active-contract set.
  receipts1 <- settleUsdTransfer admin app aliceAcct bobAcct aliceHolding 30.0 "attribution-1"
  length receipts1 === 2
  case receipts1 of
    receiptCid :: _ -> do
      Some receipt <- queryContractId app receiptCid
      receipt.settlement.executors === [app]
    [] -> fail "expected a settlement receipt"
  activity1 <- logSnapshot "step 1: app settled alice -> bob 30 USD" admin app aliceAcct bobAcct
  activity1 === AttributedActivity 1 30.0 2

  -- Step 2: a second settlement (bob -> alice 10 USD) increases the same
  -- off-ledger counters. Each confirmed batch adds to the attributable volume
  -- of the app-provider.
  bobHolding <- holdingWithAmount admin bobAcct 30.0
  _ <- settleUsdTransfer admin app bobAcct aliceAcct bobHolding 10.0 "attribution-2"
  activity2 <- logSnapshot "step 2: app settled bob -> alice 10 USD" admin app aliceAcct bobAcct
  activity2 === AttributedActivity 2 40.0 4

  -- Step 3: the walkthrough allocates a third batch (alice -> bob 20 USD).
  -- The allocation locks the 70 USD holding of alice. A party that is not the
  -- executor tries to settle the batch. The attempt fails. The attribution
  -- counters do not change: an app-provider may claim only the activity that
  -- it confirmed.
  (factory, factoryDisc) <- mkFactory admin
  settlement <- mkSettlementInfo "attribution-3" app
  let leg = mkUsdLeg "attribution-3" aliceAcct bobAcct 20.0
  aliceInput <- holdingWithAmount admin aliceAcct 70.0
  aliceAlloc <- createAndAcceptAllocation admin factory factoryDisc settlement aliceAcct [senderSide leg] [aliceInput]
  bobAlloc <- createAndAcceptAllocation admin factory factoryDisc settlement bobAcct [receiverSide leg] []
  submitMustFail (actAs [notApp] <> discloseMany [factoryDisc]) do
    exerciseCmd factory SettlementFactory_SettleBatch with
      settlement; transferLegs = [leg]; allocationCids = [aliceAlloc, bobAlloc]
      actors = [notApp]; d1ComplianceRef = None
  activity3 <- logSnapshot "step 3: non-executor settle failed (alice's 70 USD locked in the pending allocation)" admin app aliceAcct bobAcct
  activity3 === activity2

  -- Step 4: the app-provider settles the pending batch. The change returns to
  -- alice. The counters increase.
  _ <- submit (actAs [app] <> discloseMany [factoryDisc]) do
    exerciseCmd factory SettlementFactory_SettleBatch with
      settlement; transferLegs = [leg]; allocationCids = [aliceAlloc, bobAlloc]
      actors = [app]; d1ComplianceRef = None
  activity4 <- logSnapshot "step 4: app settled the pending alice -> bob 20 USD batch" admin app aliceAcct bobAcct
  activity4 === AttributedActivity 3 60.0 6

  -- Step 5: an other executor (notApp) settles a transfer where the
  -- app-provider is only the receiver (bob -> app 5 USD). The app-provider
  -- observes its own receipt and holdings-change event as an account party.
  -- The attribution does not credit them: only the settlements that the
  -- app-provider confirmed as executor count. The raw receipt count rises to
  -- 7 while the attribution stays at 3 settlements and 60 USD.
  let appAcct = basicAccount app
  bobHolding2 <- holdingWithAmount admin bobAcct 20.0
  _ <- settleUsdTransfer admin notApp bobAcct appAcct bobHolding2 5.0 "attribution-4"
  rawReceipts <- query @SettlementReceipt app
  length rawReceipts === 7
  activity5 <- logSnapshot "step 5: notApp settled bob -> app 5 USD; app attribution unchanged" admin app aliceAcct bobAcct
  activity5 === activity4

  -- Final balance check: settlement kept the supply constant at each step.
  aliceBal <- erc20BalanceOf admin aliceAcct
  bobBal <- erc20BalanceOf admin bobAcct
  appBal <- erc20BalanceOf admin appAcct
  supply <- erc20TotalSupply admin
  aliceBal === 60.0
  bobBal === 35.0
  appBal === 5.0
  supply === 100.0
