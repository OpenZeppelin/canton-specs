-- | CIP-0086 interoperability scenario mapping ERC-20-style reads and commands
-- onto the Token Standard V2 surface of the OpenZeppelin CIP-0112 registry:
--
--   * `balanceOf` / `totalSupply`  -> queries over the standard `Holding` views;
--   * `transfer`                   -> `TransferFactory_Transfer` (sender) and
--                                     `TransferInstruction_Accept` (receiver);
--   * `approve` / `allowance`      -> the `Erc20Allowance` delegation record;
--   * `transferFrom`               -> `Erc20Allowance_AuthorizeSpend`, which
--                                     instructs the registry's transfer factory
--                                     with the owner's authority, within the
--                                     approved allowance.
--
-- ERC-20 reads are projection-scoped, which CIP-0086 calls scoped visibility.
-- The registry conserves supply across transfers and settlements, and only the
-- issuer changes it.
module OpenZeppelin.Experimental.Interop.Cip0086Erc20 where

import DA.Assert ((===))
import DA.Time (addRelTime)
import Daml.Script

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.TransferInstructionV2 qualified as TransferInstructionV2
import Splice.TokenStandard.Utils (accountParties, basicAccount)

import OpenZeppelin.Experimental.Interop.Common
import OpenZeppelin.Token.Cip112.V1.Registry (TokenRules(..))

-- | ERC-20 `approve` / `allowance` as a delegation record. Mirrors the CIP-0086
-- allowance/delegation facade onto Token Standard V2.
--
-- Signatories: `owner` only - `approve` is owner-authorised, faithful to ERC-20
-- (the issuer does not consent to an allowance). Observers: `admin`, `spender`.
-- Controllers: `spender` AND `admin` co-authorise `transferFrom`
-- (`Erc20Allowance_AuthorizeSpend`). The owner's authority to instruct the
-- transfer comes from the owner-signed allowance. The registry's transfer
-- factory runs with the admin's authority as the signatory of the rules
-- contract, so the transfer needs no further authority. `admin` co-controls
-- the spend because the choice fetches the rules contract to check its admin,
-- and only the admin, the rules contract's one stakeholder, authorises that
-- fetch. The registry's own transfer checks also reject an instrument of
-- another admin. The owner names the rules contract its approval applies to,
-- so a spend only ever runs that registry's transfer factory. Choices:
-- `Erc20Allowance_AuthorizeSpend`.
-- Privacy: only owner, admin, and spender see the allowance. Authorization
-- assumptions: a delegated spend can mobilise the owner's funds but can only
-- credit a recipient whose account parties accept the pending instruction -
-- Canton has no unilateral credit, so an unscoped ERC-20 `transferFrom` to an
-- arbitrary recipient is not globally correct. Archival behavior:
-- `Erc20Allowance_AuthorizeSpend` is consuming and creates a decremented
-- successor. Failure modes: non-positive or over-allowance spend, a rules
-- contract of another issuer, and the registry's own transfer checks fail
-- closed.
template Erc20Allowance
  with
    admin : Party
    owner : Party
    ownerAccount : HoldingV2.Account
    spender : Party
    rulesCid : ContractId TokenRules
    instrumentId : Text
    allowance : Decimal
  where
    signatory owner
    observer admin, spender
    ensure allowance >= 0.0

    -- ERC-20 `transferFrom`, mapped onto the V2 surface: within the approved
    -- allowance, instruct the registry's transfer factory to move the owner's
    -- funds to the recipient. The factory locks the amount, returns the change
    -- to the owner, and creates the pending instruction that the recipient's
    -- account parties accept. The owner's authority comes from the owner-signed
    -- allowance, so no further owner action is needed at call time. `admin`
    -- co-controls the choice to authorise the fetch of the rules contract.
    choice Erc20Allowance_AuthorizeSpend
      : (TransferInstructionV2.TransferInstructionResult, ContractId Erc20Allowance)
      with
        recipient : HoldingV2.Account
        amount : Decimal
        ownerHoldingCids : [ContractId HoldingV2.Holding]
        requestedAt : Time
        executeBefore : Time
      controller spender, admin
      do
        assertMsg eErc20AmountNotPositive (amount > 0.0)
        assertMsg eErc20InsufficientAllowance (amount <= allowance)
        rules <- fetch rulesCid
        assertMsg eErc20RegistryMismatch (rules.config.admin == admin)
        result <- exercise (toInterfaceContractId @TransferInstructionV2.TransferFactory rulesCid)
          TransferInstructionV2.TransferFactory_Transfer with
            transfer = TransferInstructionV2.Transfer with
              sender = ownerAccount
              receiver = recipient
              amount
              instrumentId = HoldingV2.InstrumentId with admin; id = instrumentId
              requestedAt
              executeBefore
              inputHoldingCids = ownerHoldingCids
              meta = emptyMetadata
            actors = accountParties admin ownerAccount
            extraArgs = emptyExtraArgs
        successor <- create this with allowance = allowance - amount
        pure (result, successor)

-- | ERC-20 `transfer` on Token Standard V2: the sender's account parties
-- instruct the registry's transfer factory, which locks the amount and returns
-- the change; the receiver's account parties accept the pending instruction in
-- a submission of their own. When the receiver's parties co-sign the
-- instruction, the transfer completes in that one step instead.
erc20Transfer
  : Registry -> HoldingV2.Account -> HoldingV2.Account -> [ContractId HoldingV2.Holding] -> Decimal
  -> Script TransferInstructionV2.TransferInstructionResult
erc20Transfer registry sender receiver inputs amount = do
  now <- getTime
  let senders = accountParties registry.admin sender
      receivers = accountParties registry.admin receiver
      transfer = TransferInstructionV2.Transfer with
        sender
        receiver
        amount
        instrumentId = usdId registry.admin
        requestedAt = now
        executeBefore = addRelTime now settlementWindow
        inputHoldingCids = inputs
        meta = emptyMetadata
  instructed <- submit (actAs senders <> discloseMany [registry.disclosure]) do
    exerciseCmd (toInterfaceContractId @TransferInstructionV2.TransferFactory registry.rulesCid)
      TransferInstructionV2.TransferFactory_Transfer with
        transfer
        actors = senders
        extraArgs = emptyExtraArgs
  case instructed.output of
    TransferInstructionV2.TransferInstructionResult_Pending instructionCid ->
      submit (actAs receivers) do
        exerciseCmd instructionCid TransferInstructionV2.TransferInstruction_Accept with
          actors = receivers
          extraArgs = emptyExtraArgs
    other -> abort ("Cip0086Erc20: expected a pending transfer instruction, got: " <> show other)

-- | ERC-20 `transfer`: a holder moving value to a counterparty maps onto a
-- transfer instruction that the counterparty accepts. `balanceOf`/`totalSupply`
-- read the holdings before and after; the registry returns the change and
-- conserves the supply, so this is the ERC-20 "no inflation on transfer"
-- invariant.
test_cip0086_transferMovesValueAndConservesSupply : Script ()
test_cip0086_transferMovesValueAndConservesSupply = script do
  admin <- allocateInteropParty "erc20-xfer-admin"
  alice <- allocateInteropParty "erc20-xfer-alice"
  bob <- allocateInteropParty "erc20-xfer-bob"
  registry <- mkRegistry admin
  let aliceAcct = basicAccount alice
      bobAcct = basicAccount bob
  aliceHolding <- mintUsd registry aliceAcct 100.0

  -- balanceOf / totalSupply before.
  aliceBefore <- erc20BalanceOf admin aliceAcct
  aliceBefore === 100.0
  (erc20BalanceOf admin bobAcct) >>= \b -> b === 0.0
  (erc20TotalSupply admin) >>= \s -> s === 100.0

  result <- erc20Transfer registry aliceAcct bobAcct [aliceHolding] 30.0
  case result.output of
    TransferInstructionV2.TransferInstructionResult_Completed [_] -> pure ()
    other -> abort ("expected one holding for the receiver, got: " <> show other)

  -- balanceOf / totalSupply after: 30 moved, 70 returned as change, supply intact.
  (erc20BalanceOf admin aliceAcct) >>= \b -> b === 70.0
  (erc20BalanceOf admin bobAcct) >>= \b -> b === 30.0
  (erc20TotalSupply admin) >>= \s -> s === 100.0

-- | CIP-0086 scoped-visibility boundary: `balanceOf` is projection-scoped. A
-- party with no projection of an account's holdings reads 0 - an unscoped,
-- globally-correct ERC-20 `balanceOf` is not possible on Canton.
test_cip0086_balanceOfIsProjectionScoped : Script ()
test_cip0086_balanceOfIsProjectionScoped = script do
  admin <- allocateInteropParty "erc20-scope-admin"
  alice <- allocateInteropParty "erc20-scope-alice"
  mallory <- allocateInteropParty "erc20-scope-mallory"
  registry <- mkRegistry admin
  let aliceAcct = basicAccount alice
  _ <- mintUsd registry aliceAcct 100.0
  -- The issuer (a signatory of every holding) sees the balance; an unrelated
  -- party with no projection sees nothing.
  (erc20BalanceOf admin aliceAcct) >>= \b -> b === 100.0
  (erc20BalanceOf alice aliceAcct) >>= \b -> b === 100.0
  (erc20BalanceOf mallory aliceAcct) >>= \b -> b === 0.0

-- | CIP-0086 `approve` + `transferFrom`: a spender, within the approved
-- allowance, instructs the registry to move the owner's funds, and the
-- recipient accepts. Supply is conserved, change returns to the owner, and the
-- allowance is decremented.
test_cip0086_approveTransferFromMovesValue : Script ()
test_cip0086_approveTransferFromMovesValue = script do
  admin <- allocateInteropParty "erc20-tf-admin"
  owner <- allocateInteropParty "erc20-tf-owner"
  spender <- allocateInteropParty "erc20-tf-spender"
  recipient <- allocateInteropParty "erc20-tf-recipient"
  registry <- mkRegistry admin
  let ownerAcct = basicAccount owner
      recipientAcct = basicAccount recipient
  ownerHolding <- mintUsd registry ownerAcct 100.0

  -- approve(spender, 40) - owner-only, faithful to ERC-20.
  allowanceCid <- submit owner do
    createCmd Erc20Allowance with
      admin; owner; ownerAccount = ownerAcct; spender
      rulesCid = registry.rulesCid; instrumentId = usdSymbol; allowance = 40.0

  -- transferFrom: spender + admin co-authorise a 30 spend of the owner's funds.
  -- The owner's authority comes from the owner-signed allowance. The registry
  -- locks 30 behind the pending instruction and returns the 70 change at once.
  now <- getTime
  (result, allowanceCid2) <- submit [spender, admin] do
    exerciseCmd allowanceCid Erc20Allowance_AuthorizeSpend with
      recipient = recipientAcct
      amount = 30.0
      ownerHoldingCids = [ownerHolding]
      requestedAt = now
      executeBefore = addRelTime now settlementWindow
  instructionCid <- case result.output of
    TransferInstructionV2.TransferInstructionResult_Pending cid -> pure cid
    other -> abort ("expected a pending transfer instruction, got: " <> show other)
  (erc20BalanceOf admin ownerAcct) >>= \b -> b === 70.0

  -- The recipient's wallet accepts the pending instruction.
  _ <- submit recipient do
    exerciseCmd instructionCid TransferInstructionV2.TransferInstruction_Accept with
      actors = [recipient]
      extraArgs = emptyExtraArgs
  (erc20BalanceOf admin ownerAcct) >>= \b -> b === 70.0
  (erc20BalanceOf admin recipientAcct) >>= \b -> b === 30.0
  (erc20TotalSupply admin) >>= \s -> s === 100.0
  Some allow2 <- queryContractId admin allowanceCid2
  allow2.allowance === 10.0

-- | CIP-0086 fail-closed: `transferFrom` beyond the approved allowance is
-- rejected before any funds move.
test_cip0086_transferFromExceedsAllowanceFails : Script ()
test_cip0086_transferFromExceedsAllowanceFails = script do
  admin <- allocateInteropParty "erc20-over-admin"
  owner <- allocateInteropParty "erc20-over-owner"
  spender <- allocateInteropParty "erc20-over-spender"
  recipient <- allocateInteropParty "erc20-over-recipient"
  registry <- mkRegistry admin
  let ownerAcct = basicAccount owner
      recipientAcct = basicAccount recipient
  ownerHolding <- mintUsd registry ownerAcct 100.0
  allowanceCid <- submit owner do
    createCmd Erc20Allowance with
      admin; owner; ownerAccount = ownerAcct; spender
      rulesCid = registry.rulesCid; instrumentId = usdSymbol; allowance = 20.0
  now <- getTime
  submitMustFail [spender, admin] do
    exerciseCmd allowanceCid Erc20Allowance_AuthorizeSpend with
      recipient = recipientAcct
      amount = 30.0
      ownerHoldingCids = [ownerHolding]
      requestedAt = now
      executeBefore = addRelTime now settlementWindow
  (erc20BalanceOf admin ownerAcct) >>= \b -> b === 100.0

-- | The allowance owner controls its default archival path.
test_cip0086_allowanceArchiveIsOwnerOnly : Script ()
test_cip0086_allowanceArchiveIsOwnerOnly = script do
  admin <- allocateInteropParty "erc20-archive-admin"
  owner <- allocateInteropParty "erc20-archive-owner"
  spender <- allocateInteropParty "erc20-archive-spender"
  registry <- mkRegistry admin
  let ownerAcct = basicAccount owner
  allowanceCid <- submit owner do
    createCmd Erc20Allowance with
      admin; owner; ownerAccount = ownerAcct; spender
      rulesCid = registry.rulesCid; instrumentId = usdSymbol; allowance = 20.0
  submitMustFail admin do
    exerciseCmd allowanceCid Archive
  submit owner do
    exerciseCmd allowanceCid Archive

eErc20AmountNotPositive : Text
eErc20AmountNotPositive = "Cip0086Erc20: transferFrom amount must be positive"

eErc20InsufficientAllowance : Text
eErc20InsufficientAllowance = "Cip0086Erc20: transferFrom amount exceeds approved allowance"

eErc20RegistryMismatch : Text
eErc20RegistryMismatch = "Cip0086Erc20: the rules contract is not the approved issuer's"
