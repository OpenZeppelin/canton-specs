-- | Shared setup and ledger helpers for the CIP interoperability scenarios.
--
-- The scenarios run on the CIP-0112 registry of `OpenZeppelin/canton-contracts`
-- (`openzeppelin-token-cip112-v1`) and drive it through the Token Standard V2
-- interfaces, the way a wallet or a settlement app drives any registry that
-- implements them. The helpers name the registry's own templates in three
-- places: creating the rules contract, which is the issuer's job, the
-- admin-only mint offer that issues supply, and the holding query of
-- `usdHoldingsSeenBy`, which reads the holding template and takes its standard
-- view.
module OpenZeppelin.Experimental.Interop.Common where

import Daml.Script
import DA.Action (unless, when)
import DA.Foldable (forA_)
import DA.Optional (isNone, optionalToList)
import DA.Text qualified as T
import DA.Time (RelTime, addRelTime, days, hours, milliseconds, seconds, subTime)

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.AllocationV2 qualified as AllocationV2
import Splice.Api.Token.AllocationInstructionV2 qualified as AllocationInstructionV2
import Splice.Api.Token.TransferEventsV2 qualified as TransferEventsV2
import Splice.Api.Token.TransferInstructionV2 qualified as TransferInstructionV2
import Splice.TokenStandard.Utils (accountParties, nonIteratedAllocation, receiverSide, senderSide)

import OpenZeppelin.Token.Cip112.TypesV1 (RegistryConfig(..))
import OpenZeppelin.Token.Cip112.V1.Holding (TokenHolding(..))
import OpenZeppelin.Token.Cip112.V1.Registry (TokenRules(..), TokenRules_OfferMint(..))

-- | The settlement window of the scenarios. Each scenario reads the current
-- ledger time and settles within that window, so the scenarios run on a static
-- clock (`dpm test`, Daml Studio) and on the wallclock of a Canton LocalNet
-- participant. The window is long enough for a real network to settle in.
settlementWindow : RelTime
settlementWindow = hours 1

-- | The settlement window of the scenario that must see its deadline pass. It
-- must stay long enough for the scenario to allocate both sides of the
-- settlement on a real network, because the scenario then waits out the rest of
-- the window.
expiringSettlementWindow : RelTime
expiringSettlementWindow = seconds 30

-- | Allocate a scenario party and let the Ledger API admin users act as it.
--
-- A LocalNet participant authenticates the Ledger API. A user may then submit
-- for a party only if a `CanActAs` right names that party, and party allocation
-- grants no such right. Neither the in-memory ledger of `dpm test` nor a
-- `dpm sandbox` needs the grant, because neither authenticates the Ledger API.
-- A `dpm sandbox` still reports the admin user `participant_admin`, so the
-- grant runs there too and adds one right for each party that the run
-- allocates.
--
-- `listAllUsers` needs admin rights of its own. A gate that submits as a user
-- without them fails on that call, and the error names the user management
-- service instead of the party allocation that the caller asked for.
--
-- Scope: the grant reaches EVERY user that holds `ParticipantAdmin`, not only
-- the one user that the gate submits as, and nothing revokes it. Daml Script
-- cannot name the user that the runner submits as, so the helper finds that
-- user by looking for the admin rights instead. A gate that starts its own
-- ledger loses both effects with the ledger. A gate that runs against a
-- participant which outlives it leaves the rights behind, so point
-- `OZ_USE_EXTERNAL_LEDGER=1` at a disposable participant. The recipients hold
-- `ParticipantAdmin` already, which carries user management, so the grant gives
-- them no authority that they could not take.
allocateInteropParty : Text -> Script Party
allocateInteropParty requestedName = do
  party <- allocateParty requestedName
  users <- listAllUsers
  forA_ users $ \user -> do
    rights <- listUserRights user.userId
    when (ParticipantAdmin `elem` rights) do
      _ <- grantUserRights user.userId [CanActAs party]
      pure ()
  pure party

-- | Submit `cmds`, which must fail with an error whose message contains
-- `expected`. A failure for another reason, such as a contract the submitter
-- cannot see, fails the scenario.
submitMustFailWith : SubmitOptions -> Text -> Commands a -> Script ()
submitMustFailWith options expected cmds = do
  err <- submitWithError options cmds
  let actual = case err of
        FailureStatusError status -> status.message
        other -> show other
  unless (expected `T.isInfixOf` actual) $
    abort ("interop: expected a failure naming \"" <> expected <> "\", got: " <> actual)

-- | Move the ledger clock past `deadline`.
--
-- Only `setTime` moves the static clock of `dpm test` and Daml Studio. A
-- LocalNet participant runs on a wallclock that `setTime` cannot set, so the
-- scenario waits for the real clock instead. Sleeping tells the two clocks
-- apart: it moves a wallclock and it leaves a static clock where it is.
advancePastDeadline : Time -> Script ()
advancePastDeadline deadline = do
  before <- getTime
  sleep (milliseconds 100)
  after <- getTime
  if after == before
    then setTime (addRelTime deadline (seconds 1))
    else do
      let remaining = subTime (addRelTime deadline (seconds 1)) after
      when (remaining > seconds 0) (sleep remaining)

-- | The single USD instrument used across the exemplars.
usdId : Party -> HoldingV2.InstrumentId
usdId admin = HoldingV2.InstrumentId with admin; id = "USD"

usdSymbol : Text
usdSymbol = "USD"

-- | The choice context and metadata of a standard call that carries none.
emptyExtraArgs : ExtraArgs
emptyExtraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata

-- | A registry: its admin, its rules contract, and the disclosure that a
-- factory submission by a party other than the admin must carry. A wallet
-- obtains the disclosure from the registry's off-ledger API; the scenarios
-- read it from the ledger as the admin.
data Registry = Registry with
    admin : Party
    rulesCid : ContractId TokenRules
    disclosure : Disclosure

-- | The storage bounds of the registries the scenarios create. `maxTTL` must
-- cover the longest deadline a scenario requests, which is one settlement
-- window; `lockGrace` is how long a funding lock outlives its workflow.
registryConfig : Party -> RegistryConfig
registryConfig admin = RegistryConfig with admin; maxTTL = days 1; lockGrace = hours 1

-- | Launch a registry: the issuer creates its rules contract, and the
-- scenarios serve that contract to the other parties by explicit disclosure.
mkRegistry : Party -> Script Registry
mkRegistry admin = do
  rulesCid <- submit admin do
    createCmd TokenRules with config = registryConfig admin
  Some disclosure <- queryDisclosure @TokenRules admin rulesCid
  pure Registry with admin; rulesCid; disclosure

-- | The settlement `ref`, executed by `app`. Token Standard V2 keeps the
-- settlement deadline on each allocation, not here.
mkSettlementInfo : Text -> Party -> AllocationV2.SettlementInfo
mkSettlementInfo ref app = AllocationV2.SettlementInfo with
  executors = [app]
  id = ref
  cid = None
  meta = emptyMetadata

-- | A deadline one `window` after the current ledger time.
deadlineAfter : RelTime -> Script Time
deadlineAfter window = do
  now <- getTime
  pure (addRelTime now window)

mkUsdLeg : Text -> HoldingV2.Account -> HoldingV2.Account -> Decimal -> AllocationV2.TransferLeg
mkUsdLeg ref sender receiver amount = AllocationV2.TransferLeg with
  transferLegId = ref <> "-leg"
  sender
  receiver
  amount
  instrumentId = usdSymbol
  meta = emptyMetadata

-- | An uncommitted allocation of `sides` by `authorizer`, to settle before
-- `deadline`. An uncommitted allocation stays withdrawable at any time.
mkSpec
  : Party -> HoldingV2.Account -> [AllocationV2.TransferLegSide] -> Optional Time
  -> AllocationV2.AllocationSpecification
mkSpec admin authorizer sides deadline = AllocationV2.AllocationSpecification with
  admin
  authorizer
  transferLegSides = sides
  settlementDeadline = deadline
  nextIterationFunding = None
  committed = False
  meta = emptyMetadata

-- | Mint `amount` USD to `account` the way the registry issues supply across
-- participants: the admin offers the mint, and the account parties accept the
-- offer in a submission of their own. Returns the new unlocked holding.
mintUsd : Registry -> HoldingV2.Account -> Decimal -> Script (ContractId HoldingV2.Holding)
mintUsd registry account amount = do
  now <- getTime
  offerCid <- submit registry.admin do
    exerciseCmd registry.rulesCid TokenRules_OfferMint with
      receiver = account
      instrumentId = usdSymbol
      amount
      requestedAt = now
      executeBefore = addRelTime now settlementWindow
      reason = "interop mint"
  let receivers = accountParties registry.admin account
  result <- submit (actAs receivers) do
    exerciseCmd offerCid TransferInstructionV2.TransferInstruction_Accept with
      actors = receivers
      extraArgs = emptyExtraArgs
  case result.output of
    TransferInstructionV2.TransferInstructionResult_Completed [holdingCid] -> pure holdingCid
    other -> abort ("interop: expected a completed mint, got: " <> show other)

-- | The standard factory call that allocates `spec` for `settlement`, funded
-- by `inputs`. `actors` are the authorizer's account parties.
allocateCmd
  : Registry -> AllocationV2.SettlementInfo -> AllocationV2.AllocationSpecification
  -> [ContractId HoldingV2.Holding] -> Time -> [Party]
  -> Commands AllocationInstructionV2.AllocationInstructionResult
allocateCmd registry settlement spec inputs requestedAt actors =
  exerciseCmd (toInterfaceContractId @AllocationInstructionV2.AllocationFactory registry.rulesCid)
    AllocationInstructionV2.AllocationFactory_Allocate with
      settlement
      allocation = spec
      requestedAt
      inputHoldingCids = inputs
      extraArgs = emptyExtraArgs
      actors

-- | The allocation a completed factory call created. The registry allocates
-- synchronously: it locks the net funding and returns the ready allocation,
-- so a pending or failed result is a scenario error.
completedAllocation
  : AllocationInstructionV2.AllocationInstructionResult
  -> Script (ContractId AllocationV2.Allocation)
completedAllocation result = case result.output of
  AllocationInstructionV2.AllocationInstructionResult_Completed cid -> pure cid
  other -> abort ("interop: expected a completed allocation, got: " <> show other)

-- | Allocate `spec` through the registry's allocation factory as the
-- authorizer's account parties, with the rules contract disclosed. Returns
-- the ready-to-settle allocation; the factory returned any change already.
allocate
  : Registry -> AllocationV2.SettlementInfo -> AllocationV2.AllocationSpecification
  -> [ContractId HoldingV2.Holding]
  -> Script (ContractId AllocationV2.Allocation)
allocate registry settlement spec inputs = do
  let actors = accountParties registry.admin spec.authorizer
  requestedAt <- getTime
  result <- submit (actAs actors <> discloseMany [registry.disclosure]) $
    allocateCmd registry settlement spec inputs requestedAt actors
  completedAllocation result

-- | The standard factory call that settles `legs` against the allocations as
-- `executor`.
settleBatchCmd
  : Registry -> Party -> AllocationV2.SettlementInfo -> [AllocationV2.TransferLeg]
  -> [ContractId AllocationV2.Allocation]
  -> Commands AllocationV2.SettlementFactory_SettleBatchResult
settleBatchCmd registry executor settlement legs allocationCids =
  exerciseCmd (toInterfaceContractId @AllocationV2.SettlementFactory registry.rulesCid)
    AllocationV2.SettlementFactory_SettleBatch with
      settlement
      transferLegs = legs
      allocations = map nonIteratedAllocation allocationCids
      actors = [executor]
      extraArgs = emptyExtraArgs

-- | Settle the batch as `executor`, with the rules contract disclosed. Returns
-- the result and the transaction, which is the executor's own record of the
-- batch it confirmed.
settleBatch
  : Registry -> Party -> AllocationV2.SettlementInfo -> [AllocationV2.TransferLeg]
  -> [ContractId AllocationV2.Allocation]
  -> Script (AllocationV2.SettlementFactory_SettleBatchResult, TransactionTree)
settleBatch registry executor settlement legs allocationCids =
  submitResultAndTree (actAs executor <> discloseMany [registry.disclosure]) $
    settleBatchCmd registry executor settlement legs allocationCids

-- | Move `amount` USD from `senderAcct` to `recvAcct` as a one-leg settlement
-- executed by `app`: each side allocates its leg through the factory, the
-- sender funding its allocation with `senderHoldingCid`, and the batch settles
-- atomically. The factory returns the sender's change when it allocates.
-- Returns the settle transaction.
settleUsdTransfer
  : Registry -> Party -> HoldingV2.Account -> HoldingV2.Account
  -> ContractId HoldingV2.Holding -> Decimal -> Text
  -> Script TransactionTree
settleUsdTransfer registry app senderAcct recvAcct senderHoldingCid amount ref = do
  deadline <- deadlineAfter settlementWindow
  let settlement = mkSettlementInfo ref app
      leg = mkUsdLeg ref senderAcct recvAcct amount
  senderAlloc <- allocate registry settlement
    (mkSpec registry.admin senderAcct [senderSide leg] (Some deadline)) [senderHoldingCid]
  recvAlloc <- allocate registry settlement
    (mkSpec registry.admin recvAcct [receiverSide leg] (Some deadline)) []
  (_, tree) <- settleBatch registry app settlement [leg] [senderAlloc, recvAlloc]
  pure tree

-- | The holdings-change events a transaction emitted, in tree order. An
-- `EventLog_HoldingsChange` is an exercise of the standard event-log
-- interface, so the events of a transaction are its exercised nodes of that
-- choice. A participant streams each one to the account parties and to the
-- observers the event names.
holdingsChangeEvents : TransactionTree -> [TransferEventsV2.EventLog_HoldingsChange]
holdingsChangeEvents tree = concatMap holdingsChangeEventsOf tree.rootEvents

-- | The holdings-change events at or below one node of a transaction.
holdingsChangeEventsOf : TreeEvent -> [TransferEventsV2.EventLog_HoldingsChange]
holdingsChangeEventsOf (CreatedEvent _) = []
holdingsChangeEventsOf (ExercisedEvent e) =
  optionalToList (fromAnyChoice @TransferEventsV2.EventLog e.argument)
    <> concatMap holdingsChangeEventsOf e.childEvents

-- | The USD holdings `reader` sees, as their standard `Holding` views. A
-- holding is visible to the admin, the account parties, and the lock holders.
--
-- The scenarios read the registry's holding template and take its standard
-- view, instead of querying the `Holding` interface: the Daml Script runner
-- of this SDK names an interface by package id, and a LocalNet participant
-- accepts interface filters by package name only. The harnesses, which build
-- their own Ledger API requests, read the interface by package name.
usdHoldingsSeenBy : Party -> Script [(ContractId HoldingV2.Holding, HoldingV2.HoldingView)]
usdHoldingsSeenBy reader = do
  holdings <- query @TokenHolding reader
  pure
    [ (toInterfaceContractId cid, view (toInterface @HoldingV2.Holding holding))
    | (cid, holding) <- holdings, holding.holding.instrumentId.id == usdSymbol ]

-- | ERC-20 `balanceOf`: the spendable (unlocked) USD a `reader` can see for an
-- account. It is intentionally projection-scoped - a party with no projection of
-- the account's holdings sees 0, which is the CIP-0086 "scoped-visibility"
-- reality (an unscoped global `balanceOf` is not correct on Canton).
erc20BalanceOf : Party -> HoldingV2.Account -> Script Decimal
erc20BalanceOf reader account = do
  holdings <- usdHoldingsSeenBy reader
  pure (sum [v.amount | (_, v) <- holdings, v.account == account, isNone v.lock])

-- | ERC-20 `totalSupply`: every USD holding the `admin` (issuer) can see -
-- locked or unlocked. Conservation across settlement keeps this invariant.
erc20TotalSupply : Party -> Script Decimal
erc20TotalSupply admin = do
  holdings <- usdHoldingsSeenBy admin
  pure (sum [v.amount | (_, v) <- holdings])

-- | Find the unlocked USD holding of `account` that has the given amount, as
-- `reader` sees it.
holdingWithAmount : Party -> HoldingV2.Account -> Decimal -> Script (ContractId HoldingV2.Holding)
holdingWithAmount reader account amount = do
  holdings <- usdHoldingsSeenBy reader
  case [cid | (cid, v) <- holdings, v.account == account, v.amount == amount, isNone v.lock] of
    cid :: _ -> pure cid
    [] -> abort ("interop: no unlocked holding of " <> show amount <> " found")
