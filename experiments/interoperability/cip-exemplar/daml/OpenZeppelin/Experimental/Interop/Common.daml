-- | Shared setup and ledger helpers for the CIP interoperability scenarios.
module OpenZeppelin.Experimental.Interop.Common where

import Daml.Script
import DA.Action (when)
import DA.Foldable (forA_)
import DA.Optional (isNone)
import DA.Time (RelTime, addRelTime, hours, milliseconds, seconds, subTime)

import OpenZeppelin.Experimental.Settlement.Cip112
import OpenZeppelin.Experimental.TokenStandardFixture.V2.Metadata
import OpenZeppelin.Experimental.TokenStandardFixture.V2.Holding
import OpenZeppelin.Experimental.TokenStandardFixture.V2.Allocation
  ( Reference(..)
  , SettlementInfo(..)
  , TransferLeg(..)
  , TransferLegSide(..)
  , AllocationSpecification(..)
  )

-- | The settlement window of the scenarios. Each scenario reads the current
-- ledger time and settles within that window, so the scenarios run on a static
-- clock (`dpm test`, Daml Studio) and on the wallclock of a Canton LocalNet
-- participant. The window is long enough for a real network to settle in.
settlementWindow : RelTime
settlementWindow = hours 1

-- | The settlement window of the scenario that must see its deadline pass. It
-- must stay long enough for the scenario to allocate both sides of the
-- settlement on a real network, because the scenario then waits out the rest of
-- the window.
expiringSettlementWindow : RelTime
expiringSettlementWindow = seconds 30

-- | Allocate a scenario party and let the Ledger API admin users act as it.
--
-- A LocalNet participant authenticates the Ledger API. A user may then submit
-- for a party only if a `CanActAs` right names that party, and party allocation
-- grants no such right. The in-memory ledger of `dpm test` and an
-- unauthenticated sandbox need no grant, and they report no admin user, so the
-- grant does nothing there.
allocateInteropParty : Text -> Script Party
allocateInteropParty requestedName = do
  party <- allocateParty requestedName
  users <- listAllUsers
  forA_ users $ \user -> do
    rights <- listUserRights user.userId
    when (ParticipantAdmin `elem` rights) do
      _ <- grantUserRights user.userId [CanActAs party]
      pure ()
  pure party

-- | Move the ledger clock past `deadline`.
--
-- Only `setTime` moves the static clock of `dpm test` and Daml Studio. A
-- LocalNet participant runs on a wallclock that `setTime` cannot set, so the
-- scenario waits for the real clock instead. Sleeping tells the two clocks
-- apart: it moves a wallclock and it leaves a static clock where it is.
advancePastDeadline : Time -> Script ()
advancePastDeadline deadline = do
  before <- getTime
  sleep (milliseconds 100)
  after <- getTime
  if after == before
    then setTime (addRelTime deadline (seconds 1))
    else do
      let remaining = subTime (addRelTime deadline (seconds 1)) after
      when (remaining > seconds 0) (sleep remaining)

-- | The single USD instrument used across the exemplars.
usdId : Party -> InstrumentId
usdId admin = InstrumentId with admin; id = "USD"

usdSymbol : Text
usdSymbol = "USD"

-- | The settlement info for `ref`, with `deadline` as its settlement deadline.
mkSettlementInfoBy : Text -> Party -> Time -> SettlementInfo
mkSettlementInfoBy ref app deadline = SettlementInfo with
  executors = [app]
  settlementRef = Reference with id = ref; cidText = None
  settlementDeadline = Some deadline
  meta = emptyMetadata

-- | The settlement info for `ref`, with a deadline one settlement window after
-- the current ledger time.
mkSettlementInfo : Text -> Party -> Script SettlementInfo
mkSettlementInfo ref app = do
  now <- getTime
  pure (mkSettlementInfoBy ref app (addRelTime now settlementWindow))

mkUsdLeg : Text -> Account -> Account -> Decimal -> TransferLeg
mkUsdLeg ref sender receiver amount = TransferLeg with
  transferLegId = ref <> "-leg"
  sender
  receiver
  amount
  instrumentId = usdSymbol
  meta = emptyMetadata

-- | Mint an unlocked USD holding. `submitters` must satisfy the `ToyHolding`
-- signatories (`admin` plus the account parties).
mintUsd : [Party] -> Party -> Account -> Decimal -> Script (ContractId ToyHolding)
mintUsd submitters admin account amount =
  submit submitters do
    createCmd ToyHolding with
      admin
      account
      instrumentId = usdId admin
      amount
      lock = None
      meta = emptyMetadata
      featureFlag = experimentalFeatureFlag

-- | Create a settlement factory and return it with its disclosure.
mkFactory : Party -> Script (ContractId SettlementFactory, Disclosure)
mkFactory admin = do
  factory <- submit admin do
    createCmd SettlementFactory with
      admin
      requiresComplianceAttestation = None
      featureFlag = experimentalFeatureFlag
  Some disc <- queryDisclosure @SettlementFactory admin factory
  pure (factory, disc)

-- | Drive the V1-wallet-compatible direct-factory path: create an allocation
-- instruction for `authorizer` and accept it, returning the ready `Allocation`.
-- `inputHoldingCids` are locked on accept (empty for a pure receiver side).
createAndAcceptAllocation
  : Party
  -> ContractId SettlementFactory
  -> Disclosure
  -> SettlementInfo
  -> Account
  -> [TransferLegSide]
  -> [ContractId ToyHolding]
  -> Script (ContractId Allocation)
createAndAcceptAllocation admin factory factoryDisc settlement authorizer sides inputHoldingCids = do
  let authorizerParties = accountParties admin authorizer
  requestedAt <- getTime
  instruction <- submit (actAs authorizerParties <> discloseMany [factoryDisc]) do
    exerciseCmd factory SettlementFactory_CreateAllocationInstruction with
      allocation = AllocationSpecification with
        settlement
        admin
        authorizer
        transferLegSides = sides
        nextIterationFunding = None
        committed = False
        meta = emptyMetadata
      requestedAt
      inputHoldingCids
      d1ComplianceHook = None
      actors = authorizerParties
  result <- submit (actAs authorizerParties) do
    exerciseCmd instruction AllocationInstruction_Accept with actors = authorizerParties
  case result of
    AllocationInstructionCompleted cid -> pure cid
    _ -> abort "interop: allocation instruction did not complete"

-- | Build a sender->receiver USD transfer's two allocations and settle them
-- atomically through the real `SettlementFactory_SettleBatch`. The sender must
-- already hold `senderHoldingCid` (>= `amount`); change is returned to the
-- sender by the settlement engine. Returns the receipts.
settleUsdTransfer
  : Party
  -> Party
  -> Account
  -> Account
  -> ContractId ToyHolding
  -> Decimal
  -> Text
  -> Script [ContractId SettlementReceipt]
settleUsdTransfer admin app senderAcct recvAcct senderHoldingCid amount ref = do
  (factory, factoryDisc) <- mkFactory admin
  settlement <- mkSettlementInfo ref app
  let leg = mkUsdLeg ref senderAcct recvAcct amount
  senderAlloc <- createAndAcceptAllocation admin factory factoryDisc settlement senderAcct [senderSide leg] [senderHoldingCid]
  recvAlloc <- createAndAcceptAllocation admin factory factoryDisc settlement recvAcct [receiverSide leg] []
  submit (actAs [app] <> discloseMany [factoryDisc]) do
    exerciseCmd factory SettlementFactory_SettleBatch with
      settlement
      transferLegs = [leg]
      allocationCids = [senderAlloc, recvAlloc]
      actors = [app]
      d1ComplianceRef = None

-- | ERC-20 `balanceOf`: the spendable (unlocked) USD a `reader` can see for an
-- account. It is intentionally projection-scoped - a party with no projection of
-- the account's holdings sees 0, which is the CIP-0086 "scoped-visibility"
-- reality (an unscoped global `balanceOf` is not correct on Canton).
erc20BalanceOf : Party -> Account -> Script Decimal
erc20BalanceOf reader account = do
  hs <- query @ToyHolding reader
  let mine = filter (\(_, h) -> h.account == account && h.instrumentId.id == usdSymbol && isNone h.lock) hs
  pure (sum (map (\(_, h) -> h.amount) mine))

-- | ERC-20 `totalSupply`: every USD holding the `admin` (issuer) can see -
-- locked or unlocked. Conservation across settlement keeps this invariant.
erc20TotalSupply : Party -> Script Decimal
erc20TotalSupply admin = do
  hs <- query @ToyHolding admin
  let usd = filter (\(_, h) -> h.instrumentId.id == usdSymbol) hs
  pure (sum (map (\(_, h) -> h.amount) usd))
