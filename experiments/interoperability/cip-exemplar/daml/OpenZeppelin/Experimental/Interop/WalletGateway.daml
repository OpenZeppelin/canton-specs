-- | CIP-0103 third-party interop surface: the on-ledger half of the Wallet
-- Gateway exemplar. The off-ledger half is `experiments/interoperability/wallet-gateway/harness.mjs`,
-- which drives the registry through the Canton Wallet Gateway's CIP-0103 dApp
-- JSON-RPC API, with the wallet user held as an externally-signed party.
--
-- Every wallet-side action is a standard Token Standard V2 choice: the wallet
-- accepts the registry's mint offer (`TransferInstruction_Accept`), allocates
-- through the registry's factory (`AllocationFactory_Allocate`) in a
-- `prepareExecute` call that carries the rules contract as a disclosed
-- contract, and accepts the dApp's request (`AllocationRequest_Accept`).
-- Canton's interactive submission prepares one command per transaction, so
-- the gateway flow makes the last two separate calls; the in-memory rehearsal
-- below, whose wallet is participant-hosted, submits them as one transaction.
-- This module therefore defines no template of its own: it holds the
-- deterministic settlement parameters that the setup, settle, and verify
-- phases share, and those phases as Daml Script.
--
-- This experiment validates the integration boundary and makes no public-API,
-- conformance, audit, or production claim. Wallclock-safe by design: the
-- allocations carry no settlement deadline, so no script here calls `setTime`
-- and the gate can run against the wallclock LocalNet participant (which the
-- gateway requires). The mint offer and the registry's storage bounds expire
-- on their own clock, well after the phases complete.
module OpenZeppelin.Experimental.Interop.WalletGateway where

import DA.Assert ((===))
import DA.Optional (isNone)
import DA.Time (addRelTime)
import Daml.Script

import Splice.Api.Token.AllocationV2 qualified as AllocationV2
import Splice.Api.Token.TransferInstructionV2 qualified as TransferInstructionV2
import Splice.TokenStandard.Utils (basicAccount, receiverSide, senderSide)

import OpenZeppelin.Experimental.Interop.Cip0103Wallet
import OpenZeppelin.Experimental.Interop.Common
import OpenZeppelin.Token.Cip112.V1.Registry (TokenRules(..), TokenRules_OfferMint(..))

-- | Deterministic settlement identifiers shared by the setup script, the
-- harness, and the settle script: all three must rebuild byte-identical
-- `SettlementInfo`, `AllocationSpecification`, and `TransferLeg` values.
gatewayRef : Text
gatewayRef = "cip0103-wallet-gateway-interop"

-- | Amount the registry offers to mint to the wallet party.
gatewayMintAmount : Decimal
gatewayMintAmount = 40.0

-- | Amount the wallet party transfers to the receiver; the factory returns the
-- change when the wallet allocates, so post-settlement balances are receiver
-- 25.0 / wallet 15.0.
gatewayTransferAmount : Decimal
gatewayTransferAmount = 25.0

-- | The settlement, executed by `app`.
gatewaySettlement : Party -> AllocationV2.SettlementInfo
gatewaySettlement app = mkSettlementInfo gatewayRef app

gatewayLeg : Party -> Party -> AllocationV2.TransferLeg
gatewayLeg wallet receiver =
  mkUsdLeg gatewayRef (basicAccount wallet) (basicAccount receiver) gatewayTransferAmount

-- | The allocation the dApp requests from the wallet: the sender side of the
-- leg, with no settlement deadline, so the gateway flow runs on wallclock time.
gatewayWalletSpec : Party -> Party -> Party -> AllocationV2.AllocationSpecification
gatewayWalletSpec admin wallet receiver =
  mkSpec admin (basicAccount wallet) [senderSide (gatewayLeg wallet receiver)] None

gatewayReceiverSpec : Party -> Party -> Party -> AllocationV2.AllocationSpecification
gatewayReceiverSpec admin wallet receiver =
  mkSpec admin (basicAccount receiver) [receiverSide (gatewayLeg wallet receiver)] None

-- | Everything the off-ledger harness needs to drive the gateway phase. The
-- baseline fields snapshot pre-run state so the verify phase can assert
-- deltas: on a shared external ledger (devnet/testnet) the parties accumulate
-- holdings across runs.
data GatewaySetupOutput = GatewaySetupOutput with
    admin : Party
    app : Party
    receiver : Party
    rulesCid : ContractId TokenRules
    requestCid : ContractId AppAllocationRequest
    mintOfferCid : ContractId TransferInstructionV2.TransferInstruction
    receiverAllocationCid : ContractId AllocationV2.Allocation
    baselineWalletBalance : Decimal
    baselineReceiverBalance : Decimal
    baselineSupply : Decimal
  deriving (Eq, Show)

-- | Phase 1 (Daml Script, local parties): allocate admin / app / receiver,
-- launch the registry, emit the CIP-0103 `AllocationRequest` toward the wallet
-- party, offer the wallet its funding mint, and allocate the receiver's side.
-- The wallet party is allocated externally by the Wallet Gateway and passed in.
setup_gatewayInterop : Party -> Script GatewaySetupOutput
setup_gatewayInterop wallet = do
  admin <- allocateInteropParty "gateway-admin"
  app <- allocateInteropParty "gateway-app"
  receiver <- allocateInteropParty "gateway-receiver"
  setupGatewayInteropWith wallet admin app receiver

data GatewayExternalSetupInput = GatewayExternalSetupInput with
    wallet : Party
    operator : Party
  deriving (Eq, Show)

-- | Setup variant for external ledgers (devnet/testnet) where the runner
-- cannot allocate parties: the wallet party and a single pre-allocated
-- operator party (playing admin, executor, and receiver) are passed in. The
-- wallet stays distinct from the operator, so the balance assertions keep
-- their meaning (receiver 25.0 / wallet change 15.0).
setup_gatewayInteropExternal : GatewayExternalSetupInput -> Script GatewaySetupOutput
setup_gatewayInteropExternal input =
  setupGatewayInteropWith input.wallet input.operator input.operator input.operator

setupGatewayInteropWith : Party -> Party -> Party -> Party -> Script GatewaySetupOutput
setupGatewayInteropWith wallet admin app receiver = do
  baselineWalletBalance <- erc20BalanceOf admin (basicAccount wallet)
  baselineReceiverBalance <- erc20BalanceOf admin (basicAccount receiver)
  baselineSupply <- erc20TotalSupply admin
  registry <- mkRegistry admin
  now <- getTime
  let settlement = gatewaySettlement app
  -- The dApp's request toward the wallet.
  requestCid <- requestAllocations app settlement [gatewayWalletSpec admin wallet receiver] None
  -- The wallet's funding: the registry's standard two-step mint, which the
  -- wallet accepts through the gateway.
  mintOfferCid <- submit admin do
    exerciseCmd registry.rulesCid TokenRules_OfferMint with
      receiver = basicAccount wallet
      instrumentId = usdSymbol
      amount = gatewayMintAmount
      requestedAt = now
      executeBefore = addRelTime now settlementWindow
      reason = "gateway interop mint"
  receiverAllocationCid <- allocate registry settlement (gatewayReceiverSpec admin wallet receiver) []
  pure GatewaySetupOutput with
    admin; app; receiver
    rulesCid = registry.rulesCid
    requestCid; mintOfferCid; receiverAllocationCid
    baselineWalletBalance; baselineReceiverBalance; baselineSupply

data GatewaySettleInput = GatewaySettleInput with
    admin : Party
    app : Party
    wallet : Party
    receiver : Party
    rulesCid : ContractId TokenRules
    walletAllocationCid : ContractId AllocationV2.Allocation
    receiverAllocationCid : ContractId AllocationV2.Allocation
  deriving (Eq, Show)

-- | Phase 3 (Daml Script, executor party): settle the batch built from the
-- gateway-made wallet allocation and the script-side receiver allocation. The
-- settlement emits one holdings-change event for each of the two accounts.
settle_gatewayInterop : GatewaySettleInput -> Script ()
settle_gatewayInterop input = do
  Some disclosure <- queryDisclosure @TokenRules input.admin input.rulesCid
  let registry = Registry with admin = input.admin; rulesCid = input.rulesCid; disclosure
  (result, tree) <- settleBatch registry input.app (gatewaySettlement input.app)
    [gatewayLeg input.wallet input.receiver]
    [input.walletAllocationCid, input.receiverAllocationCid]
  length result.allocationSettleResults === 2
  let accounts = map (.account) (holdingsChangeEvents tree)
  length accounts === 2
  assertMsg "wallet-gateway interop: expected a holdings-change event on the wallet account"
    (basicAccount input.wallet `elem` accounts)
  assertMsg "wallet-gateway interop: expected a holdings-change event on the receiver account"
    (basicAccount input.receiver `elem` accounts)

data GatewayVerifyInput = GatewayVerifyInput with
    admin : Party
    app : Party
    wallet : Party
    receiver : Party
    baselineWalletBalance : Decimal
    baselineReceiverBalance : Decimal
    baselineSupply : Decimal
  deriving (Eq, Show)

-- | Phase 4 (Daml Script, local parties): assert the settled end state on the
-- issuer's projection. The wallet party's own projection (its holdings and
-- the events on its account, as the wallet sees them) is asserted by the
-- harness through the gateway's `ledgerApi` passthrough, which is exactly the
-- CIP-0103 observation surface under test.
verify_gatewayInterop : GatewayVerifyInput -> Script ()
verify_gatewayInterop input = do
  receiverBalance <- erc20BalanceOf input.admin (basicAccount input.receiver)
  receiverBalance - input.baselineReceiverBalance === gatewayTransferAmount
  walletBalance <- erc20BalanceOf input.admin (basicAccount input.wallet)
  walletBalance - input.baselineWalletBalance === gatewayMintAmount - gatewayTransferAmount
  supply <- erc20TotalSupply input.admin
  supply - input.baselineSupply === gatewayMintAmount

-- | Rehearses the gateway flow with a participant-local wallet party. The
-- third-party integration gate drives the corresponding sequence through the
-- Canton Wallet Gateway.
test_cip0103_gatewayFlowInMemory : Script ()
test_cip0103_gatewayFlowInMemory = do
  wallet <- allocateParty "gateway-wallet-local"
  setup <- setup_gatewayInterop wallet
  -- The wallet accepts its funding mint ...
  minted <- submit wallet do
    exerciseCmd setup.mintOfferCid TransferInstructionV2.TransferInstruction_Accept with
      actors = [wallet]
      extraArgs = emptyExtraArgs
  holdingCid <- case minted.output of
    TransferInstructionV2.TransferInstructionResult_Completed [cid] -> pure cid
    other -> abort ("expected a completed mint, got: " <> show other)
  -- ... and, in one submission with the rules contract disclosed, funds the
  -- requested allocation through the factory and accepts the request.
  Some disclosure <- queryDisclosure @TokenRules setup.admin setup.rulesCid
  let registry = Registry with admin = setup.admin; rulesCid = setup.rulesCid; disclosure
  requestedAt <- getTime
  allocResult <- submit (actAs wallet <> discloseMany [disclosure]) $
    const
      <$> allocateCmd registry (gatewaySettlement setup.app)
            (gatewayWalletSpec setup.admin wallet setup.receiver) [holdingCid] requestedAt [wallet]
      <*> acceptRequestCmd setup.requestCid [wallet]
  walletAllocationCid <- completedAllocation allocResult
  settle_gatewayInterop GatewaySettleInput with
    admin = setup.admin
    app = setup.app
    wallet
    receiver = setup.receiver
    rulesCid = setup.rulesCid
    walletAllocationCid
    receiverAllocationCid = setup.receiverAllocationCid
  verify_gatewayInterop GatewayVerifyInput with
    admin = setup.admin
    app = setup.app
    wallet
    receiver = setup.receiver
    baselineWalletBalance = setup.baselineWalletBalance
    baselineReceiverBalance = setup.baselineReceiverBalance
    baselineSupply = setup.baselineSupply
  -- The wallet's own projection: its change is unlocked, and nothing of it
  -- stays locked behind the settled allocation.
  (erc20BalanceOf wallet (basicAccount wallet)) >>= (=== gatewayMintAmount - gatewayTransferAmount)
  walletHoldings <- usdHoldingsSeenBy wallet
  assertMsg "wallet-gateway interop: no wallet holding should stay locked"
    (all (\(_, v) -> isNone v.lock) walletHoldings)
