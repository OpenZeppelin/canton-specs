-- | CIP-0104 rewards accounting walkthrough.
--
-- The module `Cip0104AppRewards` shows two structural properties: the
-- settlement views alone give attribution, and only the app-provider executor
-- can settle. This module shows the procedure that a CIP-0104 reward pipeline
-- applies to those properties. It shows:
--
-- * the ledger functions that an integrator calls
-- * the balances before and after each action
-- * how the attributable activity of the app-provider increases
-- * how the pipeline divides an accrued reward between the beneficiaries when
--   a round closes.
--
-- The walkthrough calls three types of ledger functions:
--
-- 1. `mintUsd` - the issuer creates a holding (`ToyHolding` create).
-- 2. `SettlementFactory_CreateAllocationInstruction` and
--    `AllocationInstruction_Accept` (through `createAndAcceptAllocation`) -
--    each side authorizes its leg.
-- 3. `SettlementFactory_SettleBatch` (through `settleUsdTransfer` or
--    directly) - the app-provider executor settles the batch.
--
-- All reward calculations are off-ledger. The function `attributedActivity`
-- gets the confirmed activity of the app-provider only from `query` results
-- over `SettlementReceipt` and `SettlementEventLogEntry`. The functions
-- `accruedReward` and `distributeReward` apply an example reward formula to
-- that activity. The walkthrough does not create reward-marker templates.
-- That is the CIP-0104 property that this module shows.
--
-- Scope: experimental interoperability behavior. The reward rate and the
-- beneficiary split are examples. They are not the traffic-proportional CC
-- calculation that CIP-0104 defines off-ledger (that calculation is deferred
-- to M2). These scenarios make no CIP-0104 reward, SV, or Scan production
-- claim.
module OpenZeppelin.Experimental.Interop.Cip0104RewardsWalkthrough where

import DA.Assert ((===))
import DA.Foldable (forA_)
import DA.List (dedup)
import DA.Optional (isNone)
import Daml.Script

import OpenZeppelin.Experimental.Settlement.Cip112
import OpenZeppelin.Experimental.Interop.Common
import OpenZeppelin.Experimental.TokenStandardFixture.V2.Allocation (TransferSide(..))
import OpenZeppelin.Experimental.TokenStandardFixture.V2.Holding

-- * Off-ledger reward model (example values)

-- | Example reward rate: the CC that accrues for each USD of settled volume
-- that the app-provider confirmed. This value is not the CIP-0104
-- traffic-proportional rate.
rewardRatePerUsd : Decimal
rewardRatePerUsd = 0.01

-- | Example beneficiary split that the pipeline applies when a round closes.
-- The weights have a sum of 1.0. Upstream, a featured app can declare a
-- maximum of 20 beneficiaries.
beneficiarySplit : [(Text, Decimal)]
beneficiarySplit =
  [ ("venue (app-provider)", 0.7)
  , ("instrument registrar", 0.2)
  , ("validator operator", 0.1)
  ]

-- | The confirmed activity of the app-provider. The data comes only from the
-- two settlement views that the executor observes. This is the CIP-0104
-- attribution surface. No marker contract supplies it.
data AttributedActivity = AttributedActivity with
    settlements : Int        -- ^ count of settled batches (unique settlement refs)
    settledVolume : Decimal  -- ^ sum of the settled sender-leg amounts, in USD
    holdingsChangeEvents : Int -- ^ count of observed `EventLog_HoldingsChange` entries
  deriving (Eq, Show)

-- | Off-ledger attribution: read the projection of the app-provider for
-- `SettlementReceipt` and `SettlementEventLogEntry`. Each settled batch makes
-- one receipt for each authorizer, and these receipts have the same
-- settlement ref. Thus the function counts batches by unique ref. The sender
-- side of each leg is in exactly one receipt. Thus the function adds the
-- sender-side amounts to get the volume.
attributedActivity : Party -> Script AttributedActivity
attributedActivity app = do
  receipts <- query @SettlementReceipt app
  events <- query @SettlementEventLogEntry app
  let refs = dedup [r.settlement.settlementRef.id | (_, r) <- receipts]
      senderAmounts =
        [ s.amount
        | (_, r) <- receipts, s <- r.settledTransferLegSides, s.side == SenderSide
        ]
  pure AttributedActivity with
    settlements = length refs
    settledVolume = sum senderAmounts
    holdingsChangeEvents = length events

-- | Example accrual: the reward is proportional to the confirmed settled
-- volume.
accruedReward : AttributedActivity -> Decimal
accruedReward activity = activity.settledVolume * rewardRatePerUsd

-- | Example distribution: divide the accrued reward of a round between the
-- declared beneficiaries.
distributeReward : Decimal -> [(Text, Decimal)]
distributeReward total = [(who, total * weight) | (who, weight) <- beneficiarySplit]

-- * Walkthrough helpers

-- | Write one snapshot to the log: the issuer-view balances, the attributed
-- activity of the app-provider, and the example accrued reward. The function
-- returns the activity, and the walkthrough makes assertions on it.
logSnapshot : Text -> Party -> Party -> Account -> Account -> Script AttributedActivity
logSnapshot label admin app aliceAcct bobAcct = do
  aliceBal <- erc20BalanceOf admin aliceAcct
  bobBal <- erc20BalanceOf admin bobAcct
  supply <- erc20TotalSupply admin
  activity <- attributedActivity app
  debug $ "== " <> label <> " =="
  debug $ "balances (issuer view): alice=" <> show aliceBal
    <> " USD, bob=" <> show bobBal
    <> " USD, totalSupply=" <> show supply <> " USD"
  debug $ "attribution (app view): settlements=" <> show activity.settlements
    <> ", settledVolume=" <> show activity.settledVolume
    <> " USD, holdingsChangeEvents=" <> show activity.holdingsChangeEvents
  debug $ "accrued reward (illustrative): " <> show (accruedReward activity) <> " CC"
  pure activity

-- | Find the unlocked USD holding of `account` that has the given amount, as
-- `reader` sees it. The issuer sees each holding that it signed.
holdingWithAmount : Party -> Account -> Decimal -> Script (ContractId ToyHolding)
holdingWithAmount reader account amount = do
  hs <- query @ToyHolding reader
  case [cid | (cid, h) <- hs, h.account == account, h.amount == amount, isNone h.lock] of
    cid :: _ -> pure cid
    [] -> abort $ "walkthrough: no unlocked holding of " <> show amount <> " found"

-- * Walkthrough

-- | Rewards accounting walkthrough, end to end:
--
-- * Step 0 - the issuer mints; no activity is attributable.
-- * Step 1 - the app-provider settles alice -> bob 30 USD; the views alone
--   give the attribution and the accrual.
-- * Step 2 - a second settlement (bob -> alice 10 USD) increases the
--   counters.
-- * Step 3 - a party that is not the executor tries to settle a pending
--   batch; the attempt fails; no reward accrues, because only confirmed
--   executor activity is attributable.
-- * Step 4 - the app-provider settles that batch; the accrual increases.
-- * Step 5 - the round closes; the walkthrough divides the accrued reward
--   between the declared beneficiaries (example calculation, off-ledger).
test_cip0104_rewardsAccountingWalkthrough : Script ()
test_cip0104_rewardsAccountingWalkthrough = script do
  setTime i0
  admin <- allocateParty "reward-walk-admin"
  app <- allocateParty "reward-walk-app"
  alice <- allocateParty "reward-walk-alice"
  bob <- allocateParty "reward-walk-bob"
  notApp <- allocateParty "reward-walk-notapp"
  let aliceAcct = basicAccount alice
      bobAcct = basicAccount bob

  -- Step 0: the issuer mints 100 USD to alice. No settlement occurred. Thus
  -- the app-provider has no attributable activity and no accrual.
  aliceHolding <- mintUsd [admin, alice] admin aliceAcct 100.0
  activity0 <- logSnapshot "step 0: minted, nothing settled" admin app aliceAcct bobAcct
  activity0 === AttributedActivity 0 0.0 0

  -- Step 1: the app-provider executes a settlement that moves 30 USD from
  -- alice to bob (allocate the two sides, then `SettlementFactory_SettleBatch`).
  -- The balances change. The app-provider now observes 1 settlement, 30 USD
  -- volume, and 2 holdings-change events. That is its attribution surface.
  _ <- settleUsdTransfer admin app aliceAcct bobAcct aliceHolding 30.0 "reward-walk-1"
  activity1 <- logSnapshot "step 1: app settled alice -> bob 30 USD" admin app aliceAcct bobAcct
  activity1 === AttributedActivity 1 30.0 2
  accruedReward activity1 === 0.30

  -- Step 2: a second settlement (bob -> alice 10 USD) increases the same
  -- off-ledger counters. Each confirmed batch adds to the attributable volume
  -- of the app-provider.
  bobHolding <- holdingWithAmount admin bobAcct 30.0
  _ <- settleUsdTransfer admin app bobAcct aliceAcct bobHolding 10.0 "reward-walk-2"
  activity2 <- logSnapshot "step 2: app settled bob -> alice 10 USD" admin app aliceAcct bobAcct
  activity2 === AttributedActivity 2 40.0 4
  accruedReward activity2 === 0.40

  -- Step 3: the walkthrough allocates a third batch (alice -> bob 20 USD).
  -- The allocation locks the 70 USD holding of alice. A party that is not the
  -- executor tries to settle the batch. The attempt fails. The attribution
  -- counters do not change: rewards accrue only on activity that the
  -- app-provider confirmed.
  (factory, factoryDisc) <- mkFactory admin
  let settlement = mkSettlementInfo "reward-walk-3" app
      leg = mkUsdLeg "reward-walk-3" aliceAcct bobAcct 20.0
  aliceInput <- holdingWithAmount admin aliceAcct 70.0
  aliceAlloc <- createAndAcceptAllocation admin factory factoryDisc settlement aliceAcct [senderSide leg] [aliceInput]
  bobAlloc <- createAndAcceptAllocation admin factory factoryDisc settlement bobAcct [receiverSide leg] []
  submitMustFail (actAs [notApp] <> discloseMany [factoryDisc]) do
    exerciseCmd factory SettlementFactory_SettleBatch with
      settlement; transferLegs = [leg]; allocationCids = [aliceAlloc, bobAlloc]
      actors = [notApp]; d1ComplianceRef = None
  activity3 <- logSnapshot "step 3: non-executor settle failed (alice's 70 USD locked in the pending allocation)" admin app aliceAcct bobAcct
  activity3 === activity2

  -- Step 4: the app-provider settles the pending batch. The change returns to
  -- alice. The counters increase.
  _ <- submit (actAs [app] <> discloseMany [factoryDisc]) do
    exerciseCmd factory SettlementFactory_SettleBatch with
      settlement; transferLegs = [leg]; allocationCids = [aliceAlloc, bobAlloc]
      actors = [app]; d1ComplianceRef = None
  activity4 <- logSnapshot "step 4: app settled the pending alice -> bob 20 USD batch" admin app aliceAcct bobAcct
  activity4 === AttributedActivity 3 60.0 6
  accruedReward activity4 === 0.60

  -- Step 5: the round closes. The walkthrough divides the accrued reward
  -- between the declared beneficiaries. The sum of the shares is always equal
  -- to the accrual (conservation of the distributed reward).
  let total = accruedReward activity4
      shares = distributeReward total
  debug "== step 5: round closes, reward distributed (illustrative) =="
  forA_ shares \(who, amt) -> debug $ who <> ": " <> show amt <> " CC"
  sum (map snd shares) === total
  shares === [("venue (app-provider)", 0.42), ("instrument registrar", 0.12), ("validator operator", 0.06)]

  -- Final balance check: settlement kept the supply constant at each step.
  aliceBal <- erc20BalanceOf admin aliceAcct
  bobBal <- erc20BalanceOf admin bobAcct
  supply <- erc20TotalSupply admin
  aliceBal === 60.0
  bobBal === 40.0
  supply === 100.0
