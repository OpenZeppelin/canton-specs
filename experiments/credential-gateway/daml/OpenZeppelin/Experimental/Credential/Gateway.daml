-- | Experimental credential gateway.
--
-- In-repo stand-in for the credential-gating primitives the RI reports
-- previously named against an external `zk-credential-gateway` evidence repo
-- (`CredentialGatedActionRequest`, `MockVerificationResult`,
-- `MockVerifierAuthorization`, `CredentialRevocationStatus`). Those types are
-- extracted here so the reports reference real, buildable in-repo code on the
-- `dpm build --all` gate instead of an external link.
--
-- This package models the D1/D3 "node-applied attestation" seam: an off-ledger
-- verifier (a stand-in for a live zero-knowledge verification service) attests
-- that a subject passed a check, and an on-ledger action gate fails closed
-- unless a fresh, non-revoked attestation from an admin-authorized verifier is
-- presented. It mirrors the trust-anchor shape already used by the identity-hook
-- Shape-B `TrustedIssuerRegistry` and the settlement spine's
-- `TrustedAttesterRegistry` / `ComplianceAttestation`.
--
-- Not public M1 surface. Every contract carries the runtime feature flag so
-- downstream code cannot accidentally treat the shape as stable. No production
-- ZK verification, key management, PII handling, or revocation-registry
-- semantics are implemented — the `Mock*` names are deliberate.
module OpenZeppelin.Experimental.Credential.Gateway where

-- | The typed kind of a verified claim. `MockVerifierAuthorization` scopes a
-- verifier to a set of these, so distinct verifiers can hold distinct roles.
data VerifiedClaimKind
  = KYC_VERIFIED
  | SANCTIONS_CLEARED
  | OTHER_VERIFIED_CLAIM
  deriving (Eq, Show)

-- | Revocation state of a credential. A gate passes only for `CredentialActive`;
-- `CredentialRevoked` fails closed even if the attestation is otherwise valid.
data CredentialRevocationStatus
  = CredentialActive
  | CredentialRevoked
  deriving (Eq, Show)

experimentalFeatureFlag : Text
experimentalFeatureFlag = "experimental.credential-gateway.enabled"

-- | Admin-owned authorization naming a verifier trusted to issue verification
-- results, scoped to the claim kinds it may attest.
--
-- Signatories: `admin`, the trust root that authorizes verifiers.
-- Observers: `verifier`, the authorized party.
-- Controllers: none.
-- Choices: none — it is the on-ledger trust anchor a gate fetches to confirm a
-- result's signer is authorized (mirrors `TrustedAttesterRegistry`).
-- Disclosed parties: admin and verifier; disclosed to a gatekeeper when a gate
-- must confirm authorization.
-- Privacy expectations: verifier membership is private to admin and the named
-- verifier unless explicitly disclosed.
-- Authorization assumptions: single-admin trust root (the S2 D4 posture); a
-- promoted surface would back `admin` with on-ledger multi-sig or a multi-hosted
-- party without changing this shape.
-- Archival behavior: no choices; rotation/revocation of authorization is out of
-- scope for this stand-in.
-- Failure modes: creation rejects a missing feature flag or an empty
-- `authorizedKinds`.
-- Upgrade and migration assumptions: experimental-only; replace with the
-- accepted credential package if one is imported.
template MockVerifierAuthorization
  with
    admin : Party
    verifier : Party
    authorizedKinds : [VerifiedClaimKind]
    featureFlag : Text
  where
    signatory admin
    observer verifier
    ensure featureFlag == experimentalFeatureFlag && not (null authorizedKinds)

-- | A signed, typed verification result — the stand-in for a live zero-knowledge
-- verification result. Its existence proves the `verifier` signed it.
--
-- Signatories: `verifier` (sole signer; makes the result unforgeable here).
-- Observers: `subject` and any `disclosedTo` parties (e.g. the gatekeeper /
-- settlement executor that must fetch and verify it at exercise time).
-- Controllers: none.
-- Choices: none — verified by `requireValidVerification` at gate time.
-- Disclosed parties: verifier, subject, and explicitly-disclosed verifiers.
-- Privacy expectations: the result is visible only to its signer, subject, and
-- disclosed parties; it stores typed metadata, not PII.
-- Authorization assumptions: the gate checks the signer is an admin-authorized
-- verifier for the required kind, that it covers the subject, that it is not
-- revoked, and that it is within its validity window. Production ZK proof
-- verification and issuer key rotation are out of scope.
-- Archival behavior: no choices; a result remains usable until it expires.
-- Failure modes: stale, wrong-subject, wrong-kind, revoked, or unauthorized-signer
-- results fail closed at the gate.
-- Upgrade and migration assumptions: experimental-only, removable on import of an
-- accepted verification package.
template MockVerificationResult
  with
    verifier : Party
    subject : Party
    disclosedTo : [Party]
    claimKind : VerifiedClaimKind
    revocationStatus : CredentialRevocationStatus
    issuedAt : Time
    expiresAt : Time
    featureFlag : Text
  where
    signatory verifier
    observer subject, disclosedTo
    ensure featureFlag == experimentalFeatureFlag

-- | A request to perform a gated action, resolved by presenting a valid
-- `MockVerificationResult` from an admin-authorized verifier.
--
-- Signatories: `requester`, the party seeking to perform the action.
-- Observers: `gatekeeper`, the party that runs the gate (e.g. the venue
-- operator / settlement executor).
-- Controllers: `gatekeeper` runs `CredentialGatedActionRequest_Gate`.
-- Choices: `CredentialGatedActionRequest_Gate` — fail-closed verification.
-- Disclosed parties: requester and gatekeeper.
-- Privacy expectations: only the requester and gatekeeper see the request; the
-- verification result is disclosed to the gatekeeper only for the gate call.
-- Authorization assumptions: the gate authorizes only that a valid attestation
-- exists for `subject` and `requiredKind`; it does not itself move assets — the
-- caller composes this check ahead of the real settlement action.
-- Archival behavior: `_Gate` is nonconsuming so the request can gate several
-- steps; it does not archive the presented result.
-- Failure modes: wrong controller, missing feature flag, or any failing
-- verification condition fails the transaction.
-- Upgrade and migration assumptions: experimental-only; the D1/D3 seam a promoted
-- surface would attach via the settlement spine's typed-attestation path.
template CredentialGatedActionRequest
  with
    requester : Party
    gatekeeper : Party
    subject : Party
    actionRef : Text
    requiredKind : VerifiedClaimKind
    featureFlag : Text
  where
    signatory requester
    observer gatekeeper
    ensure featureFlag == experimentalFeatureFlag

    nonconsuming choice CredentialGatedActionRequest_Gate : ()
      with
        actors : [Party]
        authorizationCid : ContractId MockVerifierAuthorization
        resultCid : ContractId MockVerificationResult
      controller actors
      do
        requireExperimentalFlag featureFlag
        assertMsg eGateActorsMismatch (actors == [gatekeeper])
        auth <- fetch authorizationCid
        result <- fetch resultCid
        now <- getTime
        requireValidVerification requiredKind subject now auth result

-- | Fail-closed verification predicate shared by the gate (and reusable by
-- consumers that verify a result inline): the signer is an admin-authorized
-- verifier for the required kind, the result covers the subject, the credential
-- is active (not revoked), and it is within its validity window.
requireValidVerification
  : VerifiedClaimKind
  -> Party
  -> Time
  -> MockVerifierAuthorization
  -> MockVerificationResult
  -> Update ()
requireValidVerification requiredKind subject now auth result = do
  assertMsg eFeatureDisabled
    (auth.featureFlag == experimentalFeatureFlag && result.featureFlag == experimentalFeatureFlag)
  assertMsg eVerifierNotAuthorized (result.verifier == auth.verifier)
  assertMsg eVerifierKindNotAuthorized (requiredKind `elem` auth.authorizedKinds)
  assertMsg eWrongSubject (result.subject == subject)
  assertMsg eWrongClaimKind (result.claimKind == requiredKind)
  assertMsg eCredentialRevoked (result.revocationStatus == CredentialActive)
  assertMsg eResultNotYetValid (now >= result.issuedAt)
  assertMsg eResultExpired (now <= result.expiresAt)

-- | Convenience predicate: is a verification result acceptable *on its face*?
-- Checks the credential is active (not revoked). This is the cheap, pure check
-- an RI adapter uses for a quick gate; it deliberately does NOT check the
-- validity window (needs `now`) or that the signer is a registry-trusted
-- verifier for the required kind — for the full, fail-closed check use
-- `requireValidVerification`. Kept as a total function so callers can branch on
-- it without an `Update` context.
isAccepted : MockVerificationResult -> Bool
isAccepted result = result.revocationStatus == CredentialActive

requireExperimentalFlag : Text -> Update ()
requireExperimentalFlag flag =
  assertMsg eFeatureDisabled (flag == experimentalFeatureFlag)

eFeatureDisabled : Text
eFeatureDisabled = "CredentialGateway: experimental feature flag disabled"

eGateActorsMismatch : Text
eGateActorsMismatch = "CredentialGateway: gate must be run by the gatekeeper"

eVerifierNotAuthorized : Text
eVerifierNotAuthorized = "CredentialGateway: result signer is not the authorized verifier"

eVerifierKindNotAuthorized : Text
eVerifierKindNotAuthorized = "CredentialGateway: verifier is not authorized for this claim kind"

eWrongSubject : Text
eWrongSubject = "CredentialGateway: verification result subject mismatch"

eWrongClaimKind : Text
eWrongClaimKind = "CredentialGateway: verification result is not the required claim kind"

eCredentialRevoked : Text
eCredentialRevoked = "CredentialGateway: credential has been revoked"

eResultNotYetValid : Text
eResultNotYetValid = "CredentialGateway: verification result is not yet valid"

eResultExpired : Text
eResultExpired = "CredentialGateway: verification result expired"
