-- | The standing claim a burn leaves on Canton, and the attester confirmation
-- that lets the relayer archive it once the escrow released it.
module OpenZeppelin.Experimental.Bridge.Claims where

import DA.List (unique)

import Splice.Api.Token.TransferInstructionV2 qualified as TransferInstructionV2

import OpenZeppelin.Experimental.Bridge.Attestations

-- | Who the escrow pays: the destination a holder named, or the originator of
-- a lock whose returned credit was refunded.
data ClaimPayout
  = RedemptionPayout with
      holder : Party
      destination : Text
      requestCid : ContractId TransferInstructionV2.TransferInstruction
        -- ^ The claim's nonce: the redemption request the burn consumed, as
        -- the compliance attestation binds it.
  | RefundPayout with
      nonce : Int
        -- ^ The lock whose originator the escrow refunds, once.
  deriving (Eq, Show)

-- | The redemption attestation, or the refund claim. `ba` alone signs it. An
-- attester reads it by disclosure before it signs it with its external-chain key.
template BridgeClaim with
    ba : Party
    instrumentId : Text
    amount : Decimal
    payout : ClaimPayout
  where
    signatory ba
    ensure amount > 0.0

    nonconsuming choice BridgeClaim_Read : BridgeClaim
      with
        reader : Party
        attesterRegistryCid : ContractId AttesterRegistry
      controller reader
      do
        attesterRegistry <- fetchAttesterRegistry ba attesterRegistryCid
        requireListedAttester attesterRegistry reader
        pure this

    -- | A listed attester confirms that the escrow released this claim. It
    -- creates the confirmation signed by itself alone, observed by the
    -- attesters the registry lists, or by a subset of at least N of them.
    nonconsuming choice BridgeClaim_Confirm : ContractId ReleaseConfirmation
      with
        creator : Party
        observers : Optional [Party]
        relayer : Party
        attesterRegistryCid : ContractId AttesterRegistry
      controller creator
      do
        attesterRegistry <- fetchAttesterRegistry ba attesterRegistryCid
        audience <- statementAudience attesterRegistry creator observers
        create ReleaseConfirmation with
          signers = [creator]; attesters = audience
          relayer; verifier = ba; claimCid = self

-- | The attesters' co-signed confirmation that the escrow released a claim.
-- Only the redemption gateway consumes it, under the relayer's and the
-- verifier's (`ba`'s) authority together.
template ReleaseConfirmation with
    signers : [Party]
    attesters : [Party]
    relayer : Party
    verifier : Party
    claimCid : ContractId BridgeClaim
  where
    signatory signers
    observer relayer, attesters
    ensure not (null signers) && unique signers

    choice ReleaseConfirmation_Sign : ContractId ReleaseConfirmation
      with signer : Party
      controller signer
      do
        requireSigner attesters signers signer
        create this with signers = signer :: signers

    choice ReleaseConfirmation_Consume : ()
      controller relayer, verifier
      do pure ()
