-- | Role scopes, metadata keys, and the attestation freshness check that the
-- gateways and the registries share.
module OpenZeppelin.Experimental.Bridge.Policy where

import DA.Assert (assertWithinDeadline)
import DA.TextMap qualified as TextMap
import DA.Time (RelTime, addRelTime)

import OpenZeppelin.ScopedAuthorizationGrantV1
import Splice.Api.Token.MetadataV1
import Splice.TokenStandard.Utils (reasonMetaKey, require)

-- | Namespace of every bridge role scope and metadata key.
bridgeNamespace : Text
bridgeNamespace = "bridge.reference.openzeppelin.com"

-- | Metadata key of the lock nonce on an inbound transfer instruction.
lockNonceMetaKey : Text
lockNonceMetaKey = bridgeNamespace <> "/lock-nonce"

-- | Metadata key of the external-chain destination on a redemption request.
redeemDestinationMetaKey : Text
redeemDestinationMetaKey = bridgeNamespace <> "/redeem-destination"

-- | The relayer role. One grant covers both gateways of an instrument.
relayScope : Text -> AuthorizationScope
relayScope instrumentId = bridgeScope instrumentId "relay"

-- | The pause role. Its holder sets and clears the pause state of an instrument.
pauseScope : Text -> AuthorizationScope
pauseScope instrumentId = bridgeScope instrumentId "pause"

bridgeScope : Text -> Text -> AuthorizationScope
bridgeScope instrumentId permission = AuthorizationScope with
  namespace = bridgeNamespace
  resourceType = "bridge"
  resourceId = instrumentId
  permission
  policyEpoch = 0
  resourceInstanceCid = None

-- | Require a grant from `authority` for `scope` and record its use. The
-- protected choice makes `authorization.actor` its controller.
requireRole : Party -> AuthorizationScope -> Authorization -> Update ()
requireRole authority scope authorization = do
  _ <- requireAuthorization authorization AuthorizationRequirement with
    expectedAuthority = authority
    expectedScope = scope
  pure ()

-- | The attestation has not expired, and its expiry lies within the bridge's
-- maximum attestation validity from now.
requireFresh : Text -> RelTime -> Time -> Update ()
requireFresh name maxValidity expiresAt = do
  assertWithinDeadline name expiresAt
  now <- getTime
  require (name <> " lies within the maximum attestation validity")
    (expiresAt <= now `addRelTime` maxValidity)

noExtraArgs : ExtraArgs
noExtraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata

-- | Extra arguments that carry one reason under the Token Standard reason key.
reasonExtraArgs : Text -> ExtraArgs
reasonExtraArgs reason = ExtraArgs with
  context = emptyChoiceContext
  meta = Metadata with values = TextMap.fromList [(reasonMetaKey, reason)]
