-- | The registry adapter: the module through which the gateways mint and
-- burn on the example registry. The example registry has no delegable mint
-- or burn right, so this capability carries the wTOK admin's signature into
-- the registry: a mint is the registry's admin mint offer, which `ba` accepts
-- as the bridge account's owner in the same choice, and a burn is a transfer
-- through the registry's transfer factory to the CIP-0112 burn account, both
-- on the bridge account only. Archiving it revokes both rights. A registry
-- that grants the rights in its own shape replaces this module.
module OpenZeppelin.Experimental.Bridge.RegistryAdapter where

import DA.Time (RelTime, addRelTime, seconds)

import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.MetadataV1
import Splice.Api.Token.TransferInstructionV2 qualified as TransferInstructionV2
import Splice.TokenStandard.Utils (basicAccount, burnAccount, reasonToMeta, requireMatchExpected)

import OpenZeppelin.Token.Cip112.V1.Registry (TokenRules, TokenRules_OfferMint(..))

import OpenZeppelin.Experimental.Bridge.Policy (noExtraArgs)

-- | The mint right and the burn right the wTOK admin grants `ba`, scoped to
-- the bridge account and one instrument.
template BridgeSupplyRight with
    wtokAdmin : Party
    ba : Party
    rulesCid : ContractId TokenRules
    bridgeAccount : HoldingV2.Account
    instrumentId : Text
  where
    signatory wtokAdmin
    observer ba
    ensure bridgeAccount == basicAccount ba

    -- | Mint into the bridge account: the registry's mint offer, a pending
    -- transfer instruction from the CIP-0112 mint account, accepted at once by
    -- `ba` as the bridge account's only party.
    nonconsuming choice BridgeSupplyRight_Mint : ContractId HoldingV2.Holding
      with
        amount : Decimal
        reason : Text
      controller ba
      do
        now <- getTime
        offerCid <- exercise rulesCid TokenRules_OfferMint with
          receiver = bridgeAccount
          instrumentId
          amount
          requestedAt = now
          executeBefore = now `addRelTime` completionWindow
          reason
        result <- exercise offerCid TransferInstructionV2.TransferInstruction_Accept with
          actors = [ba]
          extraArgs = noExtraArgs
        case result.output of
          TransferInstructionV2.TransferInstructionResult_Completed [holdingCid] -> pure holdingCid
          _ -> fail "expected the mint to create one holding"

    -- | Burn a bridge-account holding: a transfer of all of it to the burn account.
    nonconsuming choice BridgeSupplyRight_Burn : ()
      with
        holdingCid : ContractId HoldingV2.Holding
        reason : Text
      controller ba
      do
        holding <- fetch holdingCid
        _ <- supplyTransfer this bridgeAccount burnAccount (view holding).amount [holdingCid] reason
        pure ()

-- | A transfer from the bridge account to the CIP-0112 burn account through
-- the registry's transfer factory, completed in one step by `ba` as the
-- bridge account's owner and the wTOK admin as the burn account's only party.
-- Returns the receiver's holdings.
supplyTransfer
  : BridgeSupplyRight -> HoldingV2.Account -> HoldingV2.Account -> Decimal
  -> [ContractId HoldingV2.Holding] -> Text
  -> Update [ContractId HoldingV2.Holding]
supplyTransfer right sender receiver amount inputHoldingCids reason = do
  now <- getTime
  result <- exercise (toInterfaceContractId @TransferInstructionV2.TransferFactory right.rulesCid)
    TransferInstructionV2.TransferFactory_Transfer with
      transfer = TransferInstructionV2.Transfer with
        sender; receiver; amount; inputHoldingCids
        instrumentId = HoldingV2.InstrumentId with admin = right.wtokAdmin; id = right.instrumentId
        requestedAt = now
        executeBefore = now `addRelTime` completionWindow
        meta = reasonToMeta reason emptyMetadata
      actors = [right.ba, right.wtokAdmin]
      extraArgs = noExtraArgs
  case result.output of
    TransferInstructionV2.TransferInstructionResult_Completed cids -> pure cids
    _ -> fail "expected the supply transfer to complete in one step"

-- | The execution window of a mint offer or a burn transfer. Each completes
-- in the choice that creates it, so any window within the registry's `maxTTL`
-- serves.
completionWindow : RelTime
completionWindow = seconds 1

-- | Fetch the supply right and check that it names the gateway's own `ba`,
-- instrument, and bridge account.
fetchSupplyRight
  : Party -> Text -> HoldingV2.Account -> ContractId BridgeSupplyRight -> Update BridgeSupplyRight
fetchSupplyRight ba instrumentId bridgeAccount cid = do
  right <- fetch cid
  requireMatchExpected ("supplyRight.ba", right.ba) ba
  requireMatchExpected ("supplyRight.instrumentId", right.instrumentId) instrumentId
  requireMatchExpected ("supplyRight.bridgeAccount", right.bridgeAccount) bridgeAccount
  pure right
