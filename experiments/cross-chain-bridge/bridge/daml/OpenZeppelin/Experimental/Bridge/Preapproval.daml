-- | The recipient-signed transfer preapproval that lets the relayer run the
-- standard accept with the recipient's authority.
module OpenZeppelin.Experimental.Bridge.Preapproval where

import DA.Assert (assertWithinDeadline)

import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.TransferInstructionV2 qualified as TransferInstructionV2
import Splice.TokenStandard.Utils (basicAccount, require, requireMatchExpected)

import OpenZeppelin.Experimental.Bridge.Policy

-- | Bounds what it authorizes: the instrument, an amount ceiling, an expiry,
-- and the party that may exercise it. The recipient signs it and can archive
-- it at any time.
template TransferPreapproval with
    recipient : Party
    delegate : Party
    instrumentId : HoldingV2.InstrumentId
    maxAmount : Decimal
    expiresAt : Time
  where
    signatory recipient
    observer delegate
    ensure maxAmount > 0.0

    -- | The delegated accept: the standard accept of a pending instruction to
    -- the recipient's account, within the bounds above.
    nonconsuming choice TransferPreapproval_Accept : TransferInstructionV2.TransferInstructionResult
      with instructionCid : ContractId TransferInstructionV2.TransferInstruction
      controller delegate
      do
        assertWithinDeadline "preapproval.expiresAt" expiresAt
        instruction <- fetch instructionCid
        let transfer = (view instruction).transfer
        requireMatchExpected ("transfer.receiver", transfer.receiver) (basicAccount recipient)
        requireMatchExpected ("transfer.instrumentId", transfer.instrumentId) instrumentId
        require "transfer amount is within the preapproval ceiling" (transfer.amount <= maxAmount)
        exercise instructionCid TransferInstructionV2.TransferInstruction_Accept with
          actors = [recipient]
          extraArgs = noExtraArgs
